<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org for everything, except the Roslyn packages the worker compiles against, which come from
  the .NET team's public dotnet-tools feed so they can match the newest SDK's own compiler before
  nuget.org has it. Source mapping names those packages exactly, so nothing else can resolve from the
  second feed. See docs/decisions/the-worker-compiles-with-the-sdks-own-roslyn.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.CodeAnalysis.Analyzers" />
      <package pattern="Microsoft.CodeAnalysis.Common" />
      <package pattern="Microsoft.CodeAnalysis.CSharp" />
      <package pattern="Microsoft.CodeAnalysis.Workspaces.Common" />
      <package pattern="Microsoft.CodeAnalysis.CSharp.Workspaces" />
      <package pattern="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    </packageSource>
  </packageSourceMapping>
</configuration>
