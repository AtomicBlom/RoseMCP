<UserControl
	x:Class="RoseMcp.App.Inspector.Controls.ExecutionBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>
		<!-- The glyphs are drawn rather than taken from a font: Segoe has no step glyphs, and these are the shapes every
		     debugger uses. Stroked in the text colour, and dimmed by the bar when their button cannot be pressed. -->
		<Style x:Key="GlyphStroke" TargetType="Path">
			<Setter Property="Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
			<Setter Property="StrokeThickness" Value="1.6" />
			<Setter Property="StrokeStartLineCap" Value="Round" />
			<Setter Property="StrokeEndLineCap" Value="Round" />
			<Setter Property="StrokeLineJoin" Value="Round" />
		</Style>
		<Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
		</Style>
	</UserControl.Resources>

	<Grid ColumnSpacing="12" ColumnDefinitions="*,Auto">

		<!-- Why the app is stopped, where, who stopped it and when it lets go, with Hold beside the countdown it
		     cancels, as a word: no standard glyph means "keep it stopped until I continue", and an icon would be read
		     as Pause. -->
		<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
			<TextBlock x:Name="StopTitle" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
			<TextBlock x:Name="StopLocation" VerticalAlignment="Center" Style="{StaticResource MonoTextBlockStyle}" />
			<TextBlock x:Name="StopFacts" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
				Style="{StaticResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			<Button x:Name="HoldButton" Style="{StaticResource ChipButtonStyle}" Content="Hold" Click="OnHold"
				Visibility="Collapsed" VerticalAlignment="Center"
				ToolTipService.ToolTip="Keep it stopped until you continue" />
		</StackPanel>

		<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
			AutomationProperties.Name="Execution">

			<Button x:Name="ContinueButton" Style="{StaticResource GlyphButton}" Click="OnContinue"
				ToolTipService.ToolTip="Continue (F5)" AutomationProperties.Name="Continue (F5)"
				KeyboardAcceleratorPlacementMode="Hidden">
				<Button.KeyboardAccelerators>
					<KeyboardAccelerator Key="F5" />
				</Button.KeyboardAccelerators>
				<Viewbox Width="16" Height="16">
					<Path Data="M4.5,2.5 L4.5,13.5 L13.5,8 Z" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
				</Viewbox>
			</Button>

			<Button x:Name="PauseButton" Style="{StaticResource GlyphButton}" Click="OnPause"
				ToolTipService.ToolTip="Pause (Ctrl+Alt+Break)" AutomationProperties.Name="Pause (Ctrl+Alt+Break)"
				KeyboardAcceleratorPlacementMode="Hidden">
				<Button.KeyboardAccelerators>
					<KeyboardAccelerator Key="Pause" Modifiers="Control,Menu" />
				</Button.KeyboardAccelerators>
				<Viewbox Width="16" Height="16">
					<Canvas Width="16" Height="16">
						<Rectangle Canvas.Left="3.5" Canvas.Top="2.5" Width="3" Height="11" RadiusX="0.5" RadiusY="0.5"
							Fill="{ThemeResource TextFillColorPrimaryBrush}" />
						<Rectangle Canvas.Left="9.5" Canvas.Top="2.5" Width="3" Height="11" RadiusX="0.5" RadiusY="0.5"
							Fill="{ThemeResource TextFillColorPrimaryBrush}" />
					</Canvas>
				</Viewbox>
			</Button>

			<Border Width="1" Height="18" Margin="4,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

			<Button x:Name="StepInButton" Style="{StaticResource GlyphButton}" Click="OnStepIn"
				ToolTipService.ToolTip="Step into (F11)" AutomationProperties.Name="Step into (F11)"
				KeyboardAcceleratorPlacementMode="Hidden">
				<Button.KeyboardAccelerators>
					<KeyboardAccelerator Key="F11" />
				</Button.KeyboardAccelerators>
				<Viewbox Width="16" Height="16">
					<Canvas Width="16" Height="16">
						<Path Style="{StaticResource GlyphStroke}" Data="M8,1.5 L8,9 M5.2,6.4 L8,9.2 L10.8,6.4" />
						<Ellipse Canvas.Left="6.3" Canvas.Top="11.5" Width="3.4" Height="3.4" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
					</Canvas>
				</Viewbox>
			</Button>

			<Button x:Name="StepOverButton" Style="{StaticResource GlyphButton}" Click="OnStepOver"
				ToolTipService.ToolTip="Step over (F10)" AutomationProperties.Name="Step over (F10)"
				KeyboardAcceleratorPlacementMode="Hidden">
				<Button.KeyboardAccelerators>
					<KeyboardAccelerator Key="F10" />
				</Button.KeyboardAccelerators>
				<Viewbox Width="16" Height="16">
					<Canvas Width="16" Height="16">
						<Path Style="{StaticResource GlyphStroke}" Data="M2.8,9.2 C2.8,3.6 13.2,3.6 13.2,9.2 M10.8,7.4 L13.2,10 L15.6,7.4" />
						<Ellipse Canvas.Left="6.3" Canvas.Top="11.5" Width="3.4" Height="3.4" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
					</Canvas>
				</Viewbox>
			</Button>

			<Button x:Name="StepOutButton" Style="{StaticResource GlyphButton}" Click="OnStepOut"
				ToolTipService.ToolTip="Step out (Shift+F11)" AutomationProperties.Name="Step out (Shift+F11)"
				KeyboardAcceleratorPlacementMode="Hidden">
				<Button.KeyboardAccelerators>
					<KeyboardAccelerator Key="F11" Modifiers="Shift" />
				</Button.KeyboardAccelerators>
				<Viewbox Width="16" Height="16">
					<Canvas Width="16" Height="16">
						<Path Style="{StaticResource GlyphStroke}" Data="M8,9.5 L8,1.8 M5.2,4.6 L8,1.8 L10.8,4.6" />
						<Ellipse Canvas.Left="6.3" Canvas.Top="11.5" Width="3.4" Height="3.4" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
					</Canvas>
				</Viewbox>
			</Button>

			<Border Width="1" Height="18" Margin="4,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

			<!-- The unplug: the session ends and the app runs on. -->
			<Button x:Name="DetachButton" Style="{StaticResource GlyphButton}" Click="OnDetach"
				ToolTipService.ToolTip="Detach, leaving the app running" AutomationProperties.Name="Detach">
				<Viewbox Width="16" Height="16">
					<Canvas Width="16" Height="16">
						<Canvas.RenderTransform>
							<RotateTransform Angle="-45" CenterX="8" CenterY="8" />
						</Canvas.RenderTransform>
						<Path Style="{StaticResource GlyphStroke}" StrokeThickness="1.4"
							Data="M8,15.5 L8,13.2 M6.6,9.6 L9.4,9.6 Q10.4,9.6 10.4,10.6 L10.4,12.2 Q10.4,13.2 9.4,13.2 L6.6,13.2 Q5.6,13.2 5.6,12.2 L5.6,10.6 Q5.6,9.6 6.6,9.6 Z M6.9,9.6 L6.9,8 M9.1,9.6 L9.1,8 M6.6,2.8 L9.4,2.8 Q10.4,2.8 10.4,3.8 L10.4,5.4 Q10.4,6.4 9.4,6.4 L6.6,6.4 Q5.6,6.4 5.6,5.4 L5.6,3.8 Q5.6,2.8 6.6,2.8 Z M8,2.8 L8,0.5" />
					</Canvas>
				</Viewbox>
			</Button>
		</StackPanel>
	</Grid>
</UserControl>
