<Window
	x:Class="RoseMcp.App.Inspector.InspectorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:panes="using:RoseMcp.App.Inspector.Panes"
	xmlns:controls="using:RoseMcp.App.Inspector.Controls"
	xmlns:views="using:RoseMcp.App.Views"
	Title="RoseMCP Inspector">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid x:Name="Root" RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="0,0,0,14">

		<!-- Asks about whichever row was selected last, anywhere in the window. -->
		<Grid.KeyboardAccelerators>
			<KeyboardAccelerator Key="A" Modifiers="Control,Shift" Invoked="OnAskShortcut" />
		</Grid.KeyboardAccelerators>

		<!-- One composer for the window, opened beside whatever is being asked about. -->
		<FlyoutBase.AttachedFlyout>
			<Flyout x:Name="AskFlyout" Placement="Bottom">
				<Flyout.FlyoutPresenterStyle>
					<Style TargetType="FlyoutPresenter">
						<Setter Property="MaxWidth" Value="460" />
						<Setter Property="MinWidth" Value="380" />
					</Style>
				</Flyout.FlyoutPresenterStyle>
				<StackPanel Spacing="6" Width="420">
					<TextBlock Text="Ask an agent" Style="{StaticResource BodyStrongTextBlockStyle}" />
					<views:NoteComposerView x:Name="AskComposer" OpenLabel="Ask an agent about this…" />
				</StackPanel>
			</Flyout>
		</FlyoutBase.AttachedFlyout>

		<!-- Title bar. Draggable region only; every control in it would otherwise eat the drag. It names the process being
		     debugged, because there is one of these windows per process and the taskbar is where somebody picks between
		     them. -->
		<Grid x:Name="TitleBarArea" Grid.Row="0" Height="40" Padding="14,0" ColumnDefinitions="Auto,Auto,*">
			<Image x:Name="TitleMark" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" />
			<TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
				Text="RoseMCP Inspector" Style="{StaticResource CaptionTextBlockStyle}" />
		</Grid>

		<!-- The header: the app, who is in the session and how current this is; then why it stopped, who stopped it and
		     when it lets go, with what moves it; or, once it has gone, that it exited and where its log is. -->
		<Border x:Name="Header" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="14,0,14,10">
			<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
				<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
					<TextBlock x:Name="SessionName" Text="No session" TextTrimming="CharacterEllipsis"
						Style="{StaticResource SubtitleTextBlockStyle}" />
					<TextBlock x:Name="AppLine" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</StackPanel>

				<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False"
						Foreground="{ThemeResource RoseAccentBrush}" />
					<Button x:Name="OpenLogButton" Style="{StaticResource ChipButtonStyle}" Click="OnOpenHostLog"
						Content="Host log" IsEnabled="False"
						ToolTipService.ToolTip="Open the folder holding this session's host log" />
					<!-- Only on a session the person started: theirs to share with one agent session, and to stop sharing. -->
					<Button x:Name="ShareButton" Style="{StaticResource ChipButtonStyle}" Content="Share" Visibility="Collapsed"
						ToolTipService.ToolTip="Let one agent session reach this session through its debug tools">
						<Button.Flyout>
							<MenuFlyout x:Name="ShareMenu" Opening="OnShareOpening" />
						</Button.Flyout>
					</Button>

					<!-- A flyout rather than a toggle in the header, because what is in it is not about this session: it is a
					     preference every RoseMCP host on the machine reads. -->
					<Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}"
						ToolTipService.ToolTip="Settings">
						<Button.Content>
							<FontIcon Glyph="&#xE713;" FontSize="13" />
						</Button.Content>
						<Button.Flyout>
							<MenuFlyout Opening="OnSettingsOpening">
								<ToggleMenuFlyoutItem x:Name="ShowOnAttach"
									Text="Show inspector when the debugger attaches"
									Click="OnToggleShowInspectorOnAttach" />
								<MenuFlyoutSeparator />
								<MenuFlyoutItem x:Name="OpenSettingsFile" Text="Open the settings file"
									Click="OnOpenSettingsFile" />
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</StackPanel>

				<StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
					<Border Style="{StaticResource PillStyle}" VerticalAlignment="Center">
						<TextBlock x:Name="InSessionText" Style="{StaticResource CaptionTextBlockStyle}" />
					</Border>
					<!-- Live while the host answers; how long ago it last did, once it has gone quiet. -->
					<Border x:Name="LivePill" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Ellipse x:Name="LiveDot" Width="7" Height="7" VerticalAlignment="Center"
								Fill="{ThemeResource SystemFillColorSuccessBrush}" />
							<TextBlock x:Name="LiveText" Style="{StaticResource CaptionTextBlockStyle}" />
						</StackPanel>
					</Border>
				</StackPanel>

				<controls:ExecutionBar x:Name="Execution" Grid.Row="2" Grid.ColumnSpan="2" />

				<!-- In place of the stop line once the app has gone: that it did, when, and the log that explains it. -->
				<Grid x:Name="EndedPanel" Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="10" ColumnDefinitions="*,Auto"
					Visibility="Collapsed">
					<StackPanel Grid.Column="0" Spacing="2">
						<TextBlock x:Name="EndedTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
						<TextBlock x:Name="EndedLog" TextWrapping="Wrap" IsTextSelectionEnabled="True"
							Style="{StaticResource CaptionTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
						<Button Style="{StaticResource ChipButtonStyle}" Content="Open its log" Click="OnOpenHostLog" />
						<Button Style="{StaticResource ChipButtonStyle}" Content="Debug an app" Click="OnDebugAnother"
							ToolTipService.ToolTip="Go to the list of running apps, a launch form and the targets debugged lately" />
					</StackPanel>
				</Grid>

				<TextBlock x:Name="XamlFactText" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
			</Grid>
		</Border>

		<InfoBar x:Name="Notice" Grid.Row="2" Margin="14,0,14,10" IsOpen="False" IsClosable="True" />

		<!-- Code is the view of the stop; XAML the second view of the same session; Breakpoints what is set. The stream
		     stays beside whichever is shown. -->
		<SelectorBar x:Name="Views" Grid.Row="3" Margin="14,0,14,8" SelectionChanged="OnViewChosen">
			<SelectorBarItem x:Name="CodeView" Text="Code" IsSelected="True" />
			<SelectorBarItem x:Name="XamlView" Text="XAML" Visibility="Collapsed" />
			<SelectorBarItem x:Name="BreakpointsView" Text="Breakpoints" />
		</SelectorBar>

		<!-- Views are toggled by visibility rather than navigated to. A Frame recreates a page on every visit, which would
		     lose any open expander and the scroll position: the reader's place in what they were doing. -->
		<Grid Grid.Row="4" Margin="14,0,14,0" ColumnSpacing="14" ColumnDefinitions="*,360">
			<panes:CodePane x:Name="Code" Grid.Column="0" />
			<panes:XamlPane x:Name="Xaml" Grid.Column="0" Visibility="Collapsed" />
			<panes:BreakpointsPane x:Name="Breakpoints" Grid.Column="0" Visibility="Collapsed" />

			<Border x:Name="StreamFrame" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
				<panes:StreamPane x:Name="Stream" />
			</Border>

			<!-- Shown in place of everything about a session while the window is about none: opened on its own, or after
			     the person left a session that ended. -->
			<panes:StartPane x:Name="Start" Grid.ColumnSpan="2" Visibility="Collapsed" />

			<!-- Shown instead of the views when there is no session to show them for. -->
			<StackPanel x:Name="EmptyState" Grid.ColumnSpan="2" Spacing="10" MaxWidth="520" VerticalAlignment="Center"
				HorizontalAlignment="Center" Visibility="Collapsed">
				<TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
					Style="{StaticResource SubtitleTextBlockStyle}" />
				<TextBlock x:Name="EmptyDetail" TextWrapping="Wrap" TextAlignment="Center"
					Style="{StaticResource BodyTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
