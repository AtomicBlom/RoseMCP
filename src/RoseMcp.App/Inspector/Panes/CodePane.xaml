<UserControl
	x:Class="RoseMcp.App.Inspector.Panes.CodePane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:inspector="using:RoseMcp.Ui.Core.Inspector">

	<Grid RowDefinitions="Auto,*" RowSpacing="8">

		<!-- Rows are never yanked away. The target continuing is ordinary (a timer, a step, an agent) and a view that
		     emptied itself would lose a reader's place with no explanation. -->
		<InfoBar x:Name="StaleBar" Grid.Row="0" IsOpen="False" IsClosable="False" Severity="Informational" />

		<Grid Grid.Row="1" ColumnSpacing="12" ColumnDefinitions="300,*">

			<!-- Threads and the chosen thread's stack, on the left. -->
			<Grid Grid.Column="0" RowDefinitions="Auto,Auto,2*,Auto,3*" RowSpacing="6">
				<TextBlock Grid.Row="0" x:Name="ThreadsCaption" Text="Threads" Style="{StaticResource BodyStrongTextBlockStyle}" />
				<TextBlock Grid.Row="1" x:Name="ThreadsDetail" TextWrapping="Wrap" Visibility="Collapsed"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

				<ListView Grid.Row="2" x:Name="ThreadRows" SelectionMode="Single" SelectionChanged="OnThreadChosen"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					AutomationProperties.Name="Threads">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="inspector:ThreadRow">
							<Grid ColumnSpacing="8" ColumnDefinitions="Auto,*" Padding="0,3" Background="Transparent">
								<Grid.ContextFlyout>
									<MenuFlyout>
										<MenuFlyoutItem Text="Ask an agent about this thread…" Tag="{x:Bind}" Click="OnAskRow" />
									</MenuFlyout>
								</Grid.ContextFlyout>
								<TextBlock Grid.Column="0" Text="{x:Bind IdLabel}" VerticalAlignment="Top" MinWidth="44"
									Style="{StaticResource MonoTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
								<StackPanel Grid.Column="1" Spacing="1">
									<Grid ColumnSpacing="6" ColumnDefinitions="*,Auto">
										<TextBlock Grid.Column="0" Text="{x:Bind TopFrame}" TextTrimming="CharacterEllipsis" />
										<Border Grid.Column="1" Style="{StaticResource AccentPillStyle}" VerticalAlignment="Center"
											Visibility="{x:Bind IsStopped}">
											<TextBlock Text="stopped" Style="{StaticResource CaptionTextBlockStyle}" />
										</Border>
									</Grid>
									<TextBlock Text="{x:Bind State}" Visibility="{x:Bind HasState}" TextTrimming="CharacterEllipsis"
										Style="{StaticResource CaptionTextBlockStyle}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>

				<TextBlock Grid.Row="3" x:Name="StackCaption" Text="Stack" Margin="0,6,0,0"
					TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />

				<ListView Grid.Row="4" x:Name="FrameRows" SelectionMode="Single" SelectionChanged="OnFrameChosen"
					ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					AutomationProperties.Name="Stack">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="inspector:FrameRow">
							<Grid ColumnSpacing="8" ColumnDefinitions="Auto,*" Padding="0,3" Background="Transparent">
								<Grid.ContextFlyout>
									<MenuFlyout>
										<MenuFlyoutItem Text="Ask an agent about this frame…" Tag="{x:Bind}" Click="OnAskRow" />
									</MenuFlyout>
								</Grid.ContextFlyout>
								<TextBlock Grid.Column="0" Text="{x:Bind IndexLabel}" VerticalAlignment="Top"
									Style="{StaticResource MonoTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
								<StackPanel Grid.Column="1" Spacing="1">
									<TextBlock Text="{x:Bind Method}" TextTrimming="CharacterEllipsis" />
									<TextBlock Text="{x:Bind Where}" Visibility="{x:Bind HasWhere}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
									<TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" TextWrapping="Wrap"
										Style="{StaticResource CaptionTextBlockStyle}"
										Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Grid>

			<!-- The chosen frame's source, its locals and arguments, and what the person watches, in the middle. -->
			<Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="6">
				<TextBlock Grid.Row="0" x:Name="SourceCaption" Text="Source" Style="{StaticResource BodyStrongTextBlockStyle}"
					TextTrimming="CharacterEllipsis" />

				<TextBlock Grid.Row="1" x:Name="SourceDetail" TextWrapping="Wrap" Visibility="Collapsed"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

				<Border Grid.Row="2" CornerRadius="4" BorderThickness="1" MinHeight="120"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
					<ScrollViewer x:Name="SourceScroll" VerticalScrollBarVisibility="Auto"
						HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
						<ItemsRepeater x:Name="SourceRows">
							<ItemsRepeater.Layout>
								<StackLayout Spacing="0" />
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate x:DataType="inspector:SourceLineRow">
									<Grid Padding="8,1">
										<!-- Behind the text rather than on it, so the line execution is on stays as
										     readable as every other line. -->
										<Border Visibility="{x:Bind IsCurrent}" CornerRadius="2" Margin="-4,0"
											Background="{ThemeResource RoseAccentBrush}" Opacity="0.28" />
										<Grid ColumnSpacing="12" ColumnDefinitions="Auto,*">
											<TextBlock Grid.Column="0" Text="{x:Bind LineLabel}"
												Style="{StaticResource MonoTextBlockStyle}"
												Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
											<TextBlock Grid.Column="1" Text="{x:Bind Text}"
												Style="{StaticResource MonoTextBlockStyle}" />
										</Grid>
									</Grid>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>
					</ScrollViewer>
				</Border>

				<TextBlock Grid.Row="3" x:Name="VariablesCaption" Text="Locals" Margin="0,4,0,0"
					Style="{StaticResource BodyStrongTextBlockStyle}" />

				<TextBlock Grid.Row="4" x:Name="VariablesDetail" TextWrapping="Wrap" Visibility="Collapsed"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

				<!-- ItemsSource mode, so the tree virtualises and keyboard navigation comes free. HasUnrealizedChildren
				     is what puts an expander on a value nobody has opened yet. -->
				<TreeView Grid.Row="5" x:Name="VariableRows" MaxHeight="240"
					SelectionMode="Single" Expanding="OnValueExpanding" ItemInvoked="OnValueInvoked"
					AutomationProperties.Name="Locals and arguments">
					<TreeView.ItemTemplate>
						<DataTemplate x:DataType="inspector:VariableNode">
							<TreeViewItem ItemsSource="{x:Bind Children}"
								HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}">
								<TreeViewItem.ContextFlyout>
									<MenuFlyout>
										<MenuFlyoutItem Text="Ask an agent about this value…" Tag="{x:Bind}" Click="OnAskRow" />
										<MenuFlyoutItem Text="Watch it" Tag="{x:Bind}" Click="OnWatchValue" />
									</MenuFlyout>
								</TreeViewItem.ContextFlyout>
								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock Text="{x:Bind Name}" Style="{StaticResource MonoTextBlockStyle}" />
									<TextBlock Text="{x:Bind Value}" Style="{StaticResource MonoTextBlockStyle}"
										Foreground="{ThemeResource RoseAccentBrush}" />
									<TextBlock Text="{x:Bind TypeName}" Style="{StaticResource CaptionTextBlockStyle}"
										VerticalAlignment="Center"
										Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
									<ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}"
										Visibility="{x:Bind IsLoading, Mode=OneWay}" Width="12" Height="12" />
									<TextBlock Text="{x:Bind LoadDetail, Mode=OneWay}"
										Visibility="{x:Bind HasLoadDetail, Mode=OneWay}"
										Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
										Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
								</StackPanel>
							</TreeViewItem>
						</DataTemplate>
					</TreeView.ItemTemplate>
				</TreeView>

				<!-- What the person watches, read at the frame being looked at, at every stop. -->
				<StackPanel Grid.Row="6" Spacing="4" Margin="0,4,0,0">
					<TextBlock Text="Watch" Style="{StaticResource BodyStrongTextBlockStyle}" />
					<ListView x:Name="WatchRows" SelectionMode="Single" SelectionChanged="OnWatchChosen" MaxHeight="160"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Watch">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="inspector:WatchRow">
								<Grid ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto" Padding="0,2" Background="Transparent">
									<Grid.ContextFlyout>
										<MenuFlyout>
											<MenuFlyoutItem Text="Ask an agent about this watch…" Tag="{x:Bind}" Click="OnAskRow" />
											<MenuFlyoutItem Text="Stop watching" Tag="{x:Bind}" Click="OnRemoveWatch" />
										</MenuFlyout>
									</Grid.ContextFlyout>
									<TextBlock Grid.Column="0" Text="{x:Bind Path}" Style="{StaticResource MonoTextBlockStyle}" />
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
										<TextBlock Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource MonoTextBlockStyle}"
											Foreground="{ThemeResource RoseAccentBrush}" />
										<TextBlock Text="{x:Bind TypeName, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
											VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
										<TextBlock Text="{x:Bind Detail, Mode=OneWay}" Visibility="{x:Bind HasDetail, Mode=OneWay}"
											TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
											Style="{StaticResource CaptionTextBlockStyle}"
											Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
										<ProgressRing IsActive="{x:Bind IsReading, Mode=OneWay}"
											Visibility="{x:Bind IsReading, Mode=OneWay}" Width="12" Height="12" />
									</StackPanel>
									<Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="OnRemoveWatch"
										ToolTipService.ToolTip="Stop watching">
										<FontIcon Glyph="&#xE711;" FontSize="10" />
									</Button>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
					<TextBox x:Name="WatchInput" PlaceholderText="Add an expression, such as this._pen.Width, and press Enter"
						KeyDown="OnWatchKey" AutomationProperties.Name="Add a watch"
						ToolTipService.ToolTip="A value path: a name or a slot, then .field and [index]. Values are read from memory, so a property getter cannot be watched." />
					<TextBlock x:Name="WatchProblem" TextWrapping="Wrap" Visibility="Collapsed"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
				</StackPanel>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
