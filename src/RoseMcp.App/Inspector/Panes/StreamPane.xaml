<UserControl
	x:Class="RoseMcp.App.Inspector.Panes.StreamPane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:contracts="using:RoseMcp.Contracts"
	xmlns:local="using:RoseMcp.App.Inspector.Panes"
	xmlns:inspector="using:RoseMcp.Ui.Core.Inspector">

	<Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">

		<Grid Grid.Row="0" ColumnSpacing="8" ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0" Text="Session" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
			<ComboBox Grid.Column="1" x:Name="FilterChoice" SelectionChanged="OnFilterChosen" MinWidth="130"
				AutomationProperties.Name="Show in the session stream"
				ToolTipService.ToolTip="What the stream shows. Changing it shows what was already collected, too.">
				<ComboBoxItem Content="All" Tag="All" IsSelected="True" />
				<ComboBoxItem Content="Agent" Tag="Agent" ToolTipService.ToolTip="The agents' calls into this session, and their answers" />
				<ComboBoxItem Content="Stops" Tag="Stops" ToolTipService.ToolTip="Breakpoint hits, completed steps and pauses" />
				<ComboBoxItem Content="Exceptions" Tag="Exceptions" />
				<ComboBoxItem Content="Log" Tag="Log" ToolTipService.ToolTip="What the app logged" />
				<ComboBoxItem Content="Notes" Tag="Notes" ToolTipService.ToolTip="Your notes to an agent, and its answers" />
			</ComboBox>
		</Grid>

		<InfoBar x:Name="DroppedBar" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Informational" />

		<Grid Grid.Row="2">
			<!-- Anchored at the bottom: as rows are appended the viewer keeps the end in view by itself, which is what a
			     live stream wants. -->
			<ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" VerticalAnchorRatio="1.0">
				<ItemsRepeater x:Name="StreamRows">
					<ItemsRepeater.Layout>
						<StackLayout Spacing="2" />
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate x:DataType="inspector:StreamRow">
							<Grid ColumnSpacing="8" ColumnDefinitions="Auto,*" Padding="6,5" CornerRadius="4"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Tapped="OnRowTapped" Tag="{x:Bind}">
								<Grid.ContextFlyout>
									<MenuFlyout>
										<MenuFlyoutItem Text="Ask an agent about this…" Tag="{x:Bind}" Click="OnAskRow"
											IsEnabled="{x:Bind CanAsk, Mode=OneWay}" />
									</MenuFlyout>
								</Grid.ContextFlyout>
								<TextBlock Grid.Column="0" Text="{x:Bind Time}" VerticalAlignment="Top"
									Style="{StaticResource MonoCaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
								<StackPanel Grid.Column="1" Spacing="2">
									<TextBlock Text="{x:Bind Who}" TextTrimming="CharacterEllipsis"
										Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
										Foreground="{x:Bind local:StreamPane.BrushFor(Tone), Mode=OneWay}" />
									<TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
										FontFamily="{x:Bind local:StreamPane.FontFor(IsMono)}"
										Style="{StaticResource CaptionTextBlockStyle}" />
									<TextBlock Text="{x:Bind Detail, Mode=OneWay}" Visibility="{x:Bind HasDetail, Mode=OneWay}"
										TextWrapping="Wrap"
										Style="{StaticResource CaptionTextBlockStyle}"
										Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

									<!-- A stop's frame and a tracepoint's values, behind one expander. -->
									<Expander Visibility="{x:Bind HasEventDetail}" HorizontalAlignment="Stretch"
										HorizontalContentAlignment="Left" Padding="0">
										<Expander.Resources>
											<ResourceDictionary Source="ms-appx:///RoseMcp.Ui/Themes/FlatExpander.xaml" />
										</Expander.Resources>
										<Expander.Header>
											<TextBlock Text="{x:Bind Event.DetailHeader}" Style="{StaticResource CaptionTextBlockStyle}" />
										</Expander.Header>
										<StackPanel Spacing="6">
											<ItemsControl ItemsSource="{x:Bind Event.Frames}">
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="x:String">
														<TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis"
															Style="{StaticResource MonoCaptionTextBlockStyle}" />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
											<ItemsControl ItemsSource="{x:Bind Event.Variables}">
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="contracts:LiveVariable">
														<Grid ColumnSpacing="8" ColumnDefinitions="Auto,Auto,*">
															<TextBlock Grid.Column="0" Text="{x:Bind Name}"
																Style="{StaticResource MonoCaptionTextBlockStyle}" />
															<TextBlock Grid.Column="1" Text="{x:Bind TypeName}"
																Style="{StaticResource MonoCaptionTextBlockStyle}"
																Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
															<TextBlock Grid.Column="2" Text="{x:Bind Value}" TextTrimming="CharacterEllipsis"
																Style="{StaticResource MonoCaptionTextBlockStyle}"
																Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
														</Grid>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Expander>
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</ScrollViewer>

			<TextBlock x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300"
				TextWrapping="Wrap" TextAlignment="Center"
				Style="{StaticResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		</Grid>
	</Grid>
</UserControl>
