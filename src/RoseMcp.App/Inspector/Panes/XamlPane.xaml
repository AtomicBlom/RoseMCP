<UserControl
	x:Class="RoseMcp.App.Inspector.Panes.XamlPane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:inspector="using:RoseMcp.Ui.Core.Inspector">

	<Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

		<Grid Grid.Row="0" ColumnSpacing="10" ColumnDefinitions="Auto,*,Auto,Auto">
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
				<Button x:Name="RefreshButton" Style="{StaticResource ChipButtonStyle}"
					Content="Refresh" Click="OnRefresh"
					ToolTipService.ToolTip="Read the visual tree again." />

				<ToggleButton x:Name="PickButton" Content="Pick from app" Click="OnTogglePick"
					ToolTipService.ToolTip="Arm the app's select mode, then click an element in the app itself." />

				<ToggleButton x:Name="JustMyXamlButton" Content="Just my XAML" Click="OnToggleJustMyXaml"
					ToolTipService.ToolTip="Show only the elements the app's own markup declares, and prefer them when picking, over a control template's parts." />

				<Button x:Name="DeselectButton" Style="{StaticResource ChipButtonStyle}"
					Content="Deselect" Click="OnDeselect"
					ToolTipService.ToolTip="Clear the app's selection and its highlight." />
			</StackPanel>

			<!-- The app's own switch for its change marks, the same one as the panel's Changes button: the tree keeps its
			     marks for the whole session whatever this says. -->
			<ToggleButton Grid.Column="2" x:Name="MarkInAppButton" Content="Mark changes in the app" Click="OnToggleMarkInApp"
				ToolTipService.ToolTip="Outline the elements live edits changed in the running app, each tagged with its change. The same switch as the panel's Changes button; the tags fade after 10 minutes." />

			<CheckBox Grid.Column="3" x:Name="IncludeDefaultsBox" Content="Include defaults"
				Click="OnToggleIncludeDefaults"
				ToolTipService.ToolTip="Also list the properties the framework chose, not only what is set." />
		</Grid>

		<InfoBar x:Name="DetailBar" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Informational" />

		<Grid Grid.Row="2" ColumnSpacing="12" ColumnDefinitions="380,*">

			<Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
				<TextBlock Grid.Row="0" x:Name="TreeCaption" Style="{StaticResource BodyStrongTextBlockStyle}" />

				<Grid Grid.Row="1" ColumnSpacing="6" ColumnDefinitions="*,Auto">
					<TextBox Grid.Column="0" x:Name="FindBox" PlaceholderText="Find an element"
						TextChanged="OnFindChanged"
						AutomationProperties.Name="Find an element in the visual tree"
						ToolTipService.ToolTip="Narrow the tree to elements whose type, name, address or file holds this text." />
					<ToggleButton Grid.Column="1" x:Name="ChangedButton" Content="Changed" Click="OnToggleChanged"
						ToolTipService.ToolTip="Show only the elements a live edit changed in this session." />
				</Grid>

				<TextBlock Grid.Row="2" x:Name="FilterNote" TextWrapping="Wrap" Visibility="Collapsed"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

				<Border Grid.Row="3" CornerRadius="4" BorderThickness="1"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
					<Grid>
						<!-- ItemsSource mode, so the tree virtualises and keyboard navigation comes
						     free. Expansion and selection are bound two ways because the rows outlive
						     a refresh and are what remembers both. A filter collapses the rows it leaves
						     out rather than taking them away, for the same reason. -->
						<TreeView x:Name="Tree" SelectionMode="Single" SelectionChanged="OnElementChosen"
							AutomationProperties.Name="Visual tree">
							<TreeView.ItemTemplate>
								<DataTemplate x:DataType="inspector:XamlNodeRow">
									<TreeViewItem ItemsSource="{x:Bind Children}"
										IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
										Visibility="{x:Bind IsShown, Mode=OneWay}">
										<StackPanel Orientation="Horizontal" Spacing="8">
											<StackPanel.ContextFlyout>
												<MenuFlyout>
													<MenuFlyoutItem Text="Ask an agent about this element…" Tag="{x:Bind}" Click="OnAskRow" />
												</MenuFlyout>
											</StackPanel.ContextFlyout>
											<!-- A live edit's mark: the dot says it changed, its tooltip says what to what
											     and who. Beside the name rather than instead of anything, so a changed
											     element still reads like every other one. -->
											<Ellipse Width="7" Height="7" VerticalAlignment="Center"
												Fill="{ThemeResource RoseAccentBrush}"
												Visibility="{x:Bind IsChanged, Mode=OneWay}"
												ToolTipService.ToolTip="{x:Bind ChangeNote, Mode=OneWay}"
												AutomationProperties.Name="Changed by a live edit" />
											<!-- The short type name, with the qualified one on the tooltip:
											     a WinUI tree is almost all Microsoft.UI.Xaml.Controls, and
											     showing that spends the column on a prefix every row
											     shares and truncates the word that differs. -->
											<TextBlock Text="{x:Bind Label, Mode=OneWay}"
												ToolTipService.ToolTip="{x:Bind TypeName, Mode=OneWay}" />
											<TextBlock Text="{x:Bind Where, Mode=OneWay}"
												Visibility="{x:Bind HasWhere, Mode=OneWay}"
												VerticalAlignment="Center"
												Style="{StaticResource CaptionTextBlockStyle}"
												Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
											<Border Style="{StaticResource PillStyle}" VerticalAlignment="Center"
												Visibility="{x:Bind IsOrphan, Mode=OneWay}">
												<TextBlock Text="parent not in this tree"
													Style="{StaticResource CaptionTextBlockStyle}" />
											</Border>
										</StackPanel>
									</TreeViewItem>
								</DataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>

						<!-- Over the tree rather than instead of it, so a refresh of a tree already on
						     screen does not blank what somebody is reading. -->
						<Border x:Name="Busy" Visibility="Collapsed" Padding="20"
							Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.94">
							<StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
								<ProgressRing IsActive="True" Width="28" Height="28"
									Foreground="{ThemeResource RoseAccentBrush}" />
								<TextBlock x:Name="BusyText" TextWrapping="Wrap" TextAlignment="Center"
									Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								<Button Style="{StaticResource ChipButtonStyle}" Content="Cancel"
									HorizontalAlignment="Center" Click="OnCancel" />
							</StackPanel>
						</Border>
					</Grid>
				</Border>
			</Grid>

			<Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="6">
				<StackPanel Grid.Row="0" Spacing="2">
					<TextBlock x:Name="ElementCaption" Style="{StaticResource BodyStrongTextBlockStyle}"
						TextTrimming="CharacterEllipsis" />

					<!-- Separate from the caption, because what to do next is not the name of
					     anything and reads wrongly in the weight a name is given. -->
					<TextBlock x:Name="NothingSelected" TextWrapping="Wrap"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</StackPanel>

				<!-- A grid rather than a horizontal stack: an address is a path of one segment per
				     level, so it is routinely wider than the pane, and a stack lets it push Copy off
				     the edge (losing the button that exists because it is too long to read). -->
				<Grid Grid.Row="1" x:Name="AddressLine" ColumnSpacing="8" ColumnDefinitions="*,Auto,Auto"
					Visibility="Collapsed">
					<Border Grid.Column="0" Style="{StaticResource PillStyle}" VerticalAlignment="Center"
						HorizontalAlignment="Left" MaxWidth="520">
						<TextBlock x:Name="AddressText" TextTrimming="CharacterEllipsis"
							Style="{StaticResource MonoCaptionTextBlockStyle}" />
					</Border>
					<Button Grid.Column="1" x:Name="CopyAddressButton" Style="{StaticResource ChipButtonStyle}"
						Content="Copy" Click="OnCopyAddress"
						ToolTipService.ToolTip="Copy the address, which is how a tool that changes this element names it." />
					<TextBlock Grid.Column="2" x:Name="ElementWhere" VerticalAlignment="Center"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</Grid>

				<TextBlock Grid.Row="2" x:Name="PropertiesDetail" TextWrapping="Wrap" Visibility="Collapsed"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

				<Border Grid.Row="3" CornerRadius="4" BorderThickness="1"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
					<ListView x:Name="PropertyRows" SelectionMode="None"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="inspector:PropertyRow">
								<Grid ColumnSpacing="10" ColumnDefinitions="3,180,*,Auto" Padding="0,4">
									<!-- A bar rather than coloured text, so the value stays as readable
									     as every other value while the provenance is still visible
									     down the whole list at a glance. -->
									<Grid Grid.Column="0" CornerRadius="2" Margin="0,1">
										<Border Background="{ThemeResource RoseAccentBrush}"
											Visibility="{x:Bind IsLocal}" />
										<Border Background="{ThemeResource AccentFillColorDefaultBrush}"
											Visibility="{x:Bind IsStyle}" />
										<Border Background="{ThemeResource TextFillColorSecondaryBrush}"
											Visibility="{x:Bind IsInherited}" />
										<Border Background="{ThemeResource SystemFillColorCautionBrush}"
											Visibility="{x:Bind IsAnimation}" />
										<Border Background="{ThemeResource TextFillColorDisabledBrush}"
											Visibility="{x:Bind IsDefault}" />
										<Border Background="{ThemeResource TextFillColorTertiaryBrush}"
											Visibility="{x:Bind IsElsewhere}" />
									</Grid>

									<TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Top"
										TextTrimming="CharacterEllipsis"
										Style="{StaticResource MonoTextBlockStyle}" />

									<StackPanel Grid.Column="2" Spacing="1">
										<TextBlock Text="{x:Bind Value}" TextWrapping="Wrap"
											Style="{StaticResource MonoTextBlockStyle}" />
										<TextBlock Text="{x:Bind Where}" Visibility="{x:Bind HasWhere}"
											Style="{StaticResource CaptionTextBlockStyle}"
											Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
										<!-- What a live edit took it from and to, and who, with what and when. -->
										<StackPanel Spacing="1" Visibility="{x:Bind HasChange}">
											<TextBlock Text="{x:Bind ChangedValues}" TextWrapping="Wrap"
												Style="{StaticResource MonoCaptionTextBlockStyle}"
												Foreground="{ThemeResource RoseAccentBrush}" />
											<TextBlock Text="{x:Bind ChangedBy}" TextWrapping="Wrap"
												Style="{StaticResource CaptionTextBlockStyle}"
												Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
										</StackPanel>
									</StackPanel>

									<TextBlock Grid.Column="3" Text="{x:Bind Provenance}" VerticalAlignment="Top"
										Style="{StaticResource CaptionTextBlockStyle}"
										Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
				</Border>

				<TextBlock Grid.Row="4" x:Name="ObservedNote" TextWrapping="Wrap" Visibility="Collapsed"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

				<Button Grid.Row="5" x:Name="AskButton" Style="{StaticResource ChipButtonStyle}"
					Content="Ask an agent about this element…" Click="OnAskElement" IsEnabled="False"
					ToolTipService.ToolTip="Write a note about this element to the agent session in this debug session (Ctrl+Shift+A)." />
			</Grid>
		</Grid>
	</Grid>
</UserControl>
