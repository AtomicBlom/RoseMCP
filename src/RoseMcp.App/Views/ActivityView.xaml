<UserControl
	x:Class="RoseMcp.App.Views.ActivityView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:core="using:RoseMcp.Ui.Core.Views"
	xmlns:views="using:RoseMcp.App.Views">

	<Grid RowDefinitions="Auto,Auto,*">
		<StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
			<TextBlock Text="Activity" Style="{StaticResource SubtitleTextBlockStyle}" />
			<TextBlock x:Name="Header" Style="{StaticResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		</StackPanel>

		<!-- The filters. Each narrows what the record is asked for, so the list and its count are the record's
		     answer to that question rather than the newest page filtered after the fact. -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
			<ComboBox x:Name="AgentChoice" MinWidth="180" SelectionChanged="OnFilterChosen"
				ToolTipService.ToolTip="Only the calls one agent made, before and after any restart" />
			<ComboBox x:Name="WorkspaceChoice" MinWidth="220" SelectionChanged="OnFilterChosen"
				ToolTipService.ToolTip="Only the calls routed to one workspace" />
			<ToggleButton x:Name="FailuresOnly" Content="Failures only" Click="OnFailuresToggled" />
			<TextBox x:Name="Search" Width="220" PlaceholderText="Search tools, targets, errors" TextChanged="OnSearchChanged" />
			<Button x:Name="OpenRecord" Content="Record folder" ToolTipService.ToolTip="Open the folder the activity record is kept in" Click="OnOpenRecord"
				Style="{StaticResource ChipButtonStyle}" />
		</StackPanel>

		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="8">
				<Border Style="{StaticResource CardStyle}" Padding="6,4">
					<ItemsRepeater x:Name="List">
						<ItemsRepeater.Layout>
							<StackLayout Spacing="0" />
						</ItemsRepeater.Layout>
						<ItemsRepeater.ItemTemplate>
							<DataTemplate x:DataType="core:OperationRow">
								<views:OperationView Row="{x:Bind}" ShowWhere="True" />
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</Border>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<Button x:Name="Older" Content="Show older" Click="OnOlder" />
					<ProgressRing x:Name="Reading" Width="16" Height="16" IsActive="False" />
					<TextBlock x:Name="Footer" VerticalAlignment="Center" TextWrapping="Wrap"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<TextBlock x:Name="Empty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
			TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
	</Grid>
</UserControl>
