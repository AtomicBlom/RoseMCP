<UserControl
	x:Class="RoseMcp.App.Views.DebuggingView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:core="using:RoseMcp.Ui.Core">

	<Grid RowDefinitions="Auto,*">
		<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
			<StackPanel Grid.Column="0" Spacing="2">
				<TextBlock Text="Debugging" Style="{StaticResource SubtitleTextBlockStyle}" />
				<TextBlock x:Name="Summary" Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>
			<Button Grid.Column="1" Content="Debug an app…" Click="OnDebugAnApp" VerticalAlignment="Center"
				ToolTipService.ToolTip="Open an Inspector window on the app being debugged" />
		</Grid>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<ItemsRepeater x:Name="Sessions">
				<ItemsRepeater.Layout>
					<StackLayout Spacing="10" />
				</ItemsRepeater.Layout>
				<ItemsRepeater.ItemTemplate>
					<DataTemplate x:DataType="core:SessionRow">
						<Border Style="{StaticResource CardStyle}" Padding="14,12">
							<StackPanel Spacing="4">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
									<Border Style="{StaticResource PillStyle}">
										<TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
									</Border>
									<Border Style="{StaticResource AccentPillStyle}" Visibility="{x:Bind IsStopped, Mode=OneWay}">
										<TextBlock Text="{x:Bind ExecutionLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
									</Border>
								</StackPanel>
								<TextBlock Text="{x:Bind Facts, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								<TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
									<Run Text="attached " /><Run Text="{x:Bind Attached, Mode=OneWay}" />
									<Run Text=" · " /><Run Text="{x:Bind ReportAge, Mode=OneWay}" />
									<Run Text=" · " /><Run Text="{x:Bind Heartbeat, Mode=OneWay}" />
								</TextBlock>
								<TextBlock Text="{x:Bind ResumeLabel, Mode=OneWay}" Visibility="{x:Bind IsStopped, Mode=OneWay}"
									Style="{StaticResource CaptionTextBlockStyle}" />
								<TextBlock Text="{x:Bind XamlFact, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
								<TextBlock Text="{x:Bind InstallLocation, Mode=OneWay}" Visibility="{x:Bind HasInstallLocation, Mode=OneWay}"
									TextTrimming="CharacterEllipsis" Style="{StaticResource MonoCaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
								<TextBlock Text="{x:Bind Detail, Mode=OneWay}" Visibility="{x:Bind IsFaulted, Mode=OneWay}" TextWrapping="Wrap"
									Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
								<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
									<Button Content="Open" Click="OnOpen" ToolTipService.ToolTip="Open its Inspector window" />
									<Button Content="Open its log" Click="OnOpenLog" />
									<Button Content="Detach" Click="OnDetach" ToolTipService.ToolTip="End the session. The app keeps running." />
								</StackPanel>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</ScrollViewer>

		<TextBlock x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
			TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

		<InfoBar x:Name="Notice" Grid.Row="1" VerticalAlignment="Bottom" IsOpen="False" IsClosable="True" />
	</Grid>
</UserControl>
