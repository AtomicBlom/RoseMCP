<UserControl
	x:Class="RoseMcp.App.Views.MemoryBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Rose's own memory, the debugged apps apart from it, and the machine's total. -->
	<Grid x:Name="Bar" Padding="14,6" ColumnSpacing="14" ColumnDefinitions="Auto,Auto,*,Auto"
		Background="{ThemeResource LayerFillColorDefaultBrush}"
		BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
		<TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}">
			<Run Text="Rose" FontWeight="SemiBold" />
			<Run x:Name="Total" />
		</TextBlock>
		<TextBlock x:Name="Split" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		<TextBlock x:Name="Debugged" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
			Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		<TextBlock x:Name="Machine" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
			Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
	</Grid>
</UserControl>
