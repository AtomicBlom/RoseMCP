<UserControl
	x:Class="RoseMcp.App.Views.OperationView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:core="using:RoseMcp.Ui.Core.Views">

	<!-- One operation: a line that opens to its body. The same control on an agent's card and in the Activity
	     view, so an operation reads one way wherever it is. -->
	<StackPanel>

		<!-- A broker starting: a line across the list, not a row that opens. -->
		<Grid Visibility="{x:Bind Row.IsMarker, Mode=OneWay}" Padding="8,6" ColumnSpacing="8" ColumnDefinitions="Auto,*">
			<FontIcon Grid.Column="0" Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
			<TextBlock Grid.Column="1" Text="{x:Bind Row.MarkerText, Mode=OneWay}" TextWrapping="Wrap"
				Style="{StaticResource CaptionTextBlockStyle}" FontStyle="Italic"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		</Grid>

		<Button Visibility="{x:Bind Row.IsCall, Mode=OneWay}" Click="OnToggle" HorizontalAlignment="Stretch"
			HorizontalContentAlignment="Stretch" Padding="8,4" Background="Transparent" BorderThickness="0"
			ToolTipService.ToolTip="{x:Bind Row.Tool, Mode=OneWay}">
			<StackPanel Spacing="2">
				<Grid ColumnSpacing="8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="64" />
						<ColumnDefinition Width="16" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="72" />
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0" Text="{x:Bind Row.Time, Mode=OneWay}" VerticalAlignment="Center"
						Style="{StaticResource MonoCaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

					<Grid Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="{x:Bind Row.Glyph, Mode=OneWay}" Visibility="{x:Bind Row.IsRunning, Mode=OneWay}"
							Foreground="{ThemeResource RoseAccentBrush}" />
						<TextBlock Text="{x:Bind Row.Glyph, Mode=OneWay}" Visibility="{x:Bind Row.Succeeded, Mode=OneWay}"
							Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
						<TextBlock Text="{x:Bind Row.Glyph, Mode=OneWay}" Visibility="{x:Bind Row.Failed, Mode=OneWay}"
							Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
						<TextBlock Text="{x:Bind Row.Glyph, Mode=OneWay}" Visibility="{x:Bind Row.Cancelled, Mode=OneWay}"
							Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
					</Grid>

					<TextBlock Grid.Column="2" Text="{x:Bind Row.Tool, Mode=OneWay}" VerticalAlignment="Center"
						Style="{StaticResource MonoTextBlockStyle}" />

					<TextBlock Grid.Column="3" Text="{x:Bind Row.Target, Mode=OneWay}" VerticalAlignment="Center"
						TextTrimming="CharacterEllipsis" Style="{StaticResource MonoTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

					<TextBlock Grid.Column="4" Visibility="{x:Bind ShowWhere, Mode=OneWay}" VerticalAlignment="Center"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorTertiaryBrush}">
						<Run Text="{x:Bind Row.Where, Mode=OneWay}" />
						<Run Text=" · " />
						<Run Text="{x:Bind Row.Client, Mode=OneWay}" />
					</TextBlock>

					<!-- The duration is always the right-hand column, counting up while the call runs. -->
					<TextBlock Grid.Column="5" Text="{x:Bind Row.Duration, Mode=OneWay}" HorizontalAlignment="Right"
						VerticalAlignment="Center" Style="{StaticResource MonoCaptionTextBlockStyle}" />
				</Grid>

				<TextBlock Text="{x:Bind Row.Error, Mode=OneWay}" Visibility="{x:Bind Row.HasError, Mode=OneWay}"
					Margin="88,0,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
				<TextBlock Text="{x:Bind Row.Detail, Mode=OneWay}" Visibility="{x:Bind Row.HasDetail, Mode=OneWay}"
					Margin="88,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
			</StackPanel>
		</Button>

		<!-- The body, read when the row is opened. -->
		<StackPanel Visibility="{x:Bind Row.IsExpanded, Mode=OneWay}" Margin="88,4,8,10" Spacing="10">
			<ProgressRing IsActive="{x:Bind Row.IsLoading, Mode=OneWay}" Width="16" Height="16" HorizontalAlignment="Left"
				Visibility="{x:Bind Row.IsLoading, Mode=OneWay}" />

			<TextBlock Text="{x:Bind Row.BodyProblem, Mode=OneWay}" Visibility="{x:Bind Row.HasBodyProblem, Mode=OneWay}"
				TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource SystemFillColorCautionBrush}" />

			<ItemsControl ItemsSource="{x:Bind Row.Changes, Mode=OneWay}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="core:FileChangeView">
						<StackPanel Spacing="4" Margin="0,0,0,8">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="Change" Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
								<TextBlock Text="{x:Bind FileName}" Style="{StaticResource MonoTextBlockStyle}" VerticalAlignment="Center"
									ToolTipService.ToolTip="{x:Bind FilePath}" />
								<TextBlock Text="{x:Bind Facts}" Visibility="{x:Bind HasFacts}" VerticalAlignment="Center"
									Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
								<HyperlinkButton Content="Open the file" Click="OnOpenFile" Tag="{x:Bind FilePath}" Padding="4,0" />
							</StackPanel>
							<Border Style="{StaticResource CardStyle}" Padding="0,4" Visibility="{x:Bind HasDiff}">
								<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="360">
									<ItemsControl ItemsSource="{x:Bind Diff}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="core:DiffLine">
												<Grid>
													<Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="{x:Bind IsAdded}" />
													<Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind IsRemoved}" />
													<TextBlock Text="{x:Bind Text}" Padding="8,0" IsTextSelectionEnabled="True"
														Style="{StaticResource MonoCaptionTextBlockStyle}" />
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Border>
							<TextBlock Text="{x:Bind DiffNote}" Visibility="{x:Bind HasDiffNote}" TextWrapping="Wrap"
								Style="{StaticResource CaptionTextBlockStyle}"
								Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<StackPanel Spacing="4" Visibility="{x:Bind Row.HasResponse, Mode=OneWay}">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<TextBlock Text="Response" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
						Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
					<HyperlinkButton Content="Copy" Click="OnCopyResponse" Padding="4,0" />
				</StackPanel>
				<Border Style="{StaticResource CardStyle}" Padding="8,6">
					<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="360">
						<TextBlock Text="{x:Bind Row.Response, Mode=OneWay}" IsTextSelectionEnabled="True"
							Style="{StaticResource MonoCaptionTextBlockStyle}" />
					</ScrollViewer>
				</Border>
			</StackPanel>

			<StackPanel Spacing="4" Visibility="{x:Bind Row.HasArguments, Mode=OneWay}">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<TextBlock Text="Arguments" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
						Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
					<HyperlinkButton Content="Copy as JSON" Click="OnCopyArguments" Padding="4,0" />
				</StackPanel>
				<Border Style="{StaticResource CardStyle}" Padding="8,6">
					<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="240">
						<TextBlock Text="{x:Bind Row.Arguments, Mode=OneWay}" IsTextSelectionEnabled="True"
							Style="{StaticResource MonoCaptionTextBlockStyle}" />
					</ScrollViewer>
				</Border>
			</StackPanel>

			<TextBlock Text="{x:Bind Row.Notes, Mode=OneWay}" Visibility="{x:Bind Row.HasNotes, Mode=OneWay}" TextWrapping="Wrap"
				Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
			<TextBlock Text="{x:Bind Row.CallId, Mode=OneWay}" Visibility="{x:Bind Row.HasCallId, Mode=OneWay}" TextWrapping="Wrap"
				IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
		</StackPanel>
	</StackPanel>
</UserControl>
