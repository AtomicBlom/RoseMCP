<Application
	x:Class="RoseMcp.Inspector.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

				<!-- After XamlControlsResources, and that order is load-bearing: every style in it is
				     BasedOn a stock WinUI one, which resolves at parse time up this chain. The other
				     order fails to parse, and the only symptom is the process disappearing during the
				     App constructor. -->
				<ResourceDictionary Source="ms-appx:///RoseMcp.Ui/Themes/Rose.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
</Application>
