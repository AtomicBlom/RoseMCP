<UserControl
	x:Class="RoseMcp.Inspector.Controls.ExecutionBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid ColumnSpacing="10" ColumnDefinitions="Auto,*,Auto">
		<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
			<Button x:Name="PauseButton" Style="{StaticResource ChipButtonStyle}"
				Content="Pause" Click="OnPause"
				ToolTipService.ToolTip="Stop the target where it is, rather than waiting for a breakpoint." />

			<Button x:Name="ContinueButton" Style="{StaticResource ChipButtonStyle}"
				Content="Continue" Click="OnContinue"
				ToolTipService.ToolTip="Let the target run on." />

			<Button x:Name="StepInButton" Style="{StaticResource ChipButtonStyle}"
				Content="Step in" Click="OnStepIn"
				ToolTipService.ToolTip="Into the call on this line, or to the next line if there is none." />

			<Button x:Name="StepOverButton" Style="{StaticResource ChipButtonStyle}"
				Content="Step over" Click="OnStepOver"
				ToolTipService.ToolTip="To the next line of this method, running any call on the way." />

			<Button x:Name="StepOutButton" Style="{StaticResource ChipButtonStyle}"
				Content="Step out" Click="OnStepOut"
				ToolTipService.ToolTip="Until this method returns, and stop in whatever called it." />
		</StackPanel>

		<TextBlock x:Name="HoldText" Grid.Column="1" VerticalAlignment="Center"
			HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
			Style="{StaticResource CaptionTextBlockStyle}"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

		<Button x:Name="ReleaseButton" Grid.Column="2" Style="{StaticResource ChipButtonStyle}"
			Content="Release" Click="OnRelease" Visibility="Collapsed"
			ToolTipService.ToolTip="Give the stop back to its own safety timer." />
	</Grid>
</UserControl>
