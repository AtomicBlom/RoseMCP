<Window
	x:Class="RoseMcp.Inspector.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:panes="using:RoseMcp.Inspector.Panes"
	Title="RoseMCP Inspector">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="0,0,0,14">

		<!-- Title bar. Draggable region only; every control in it would otherwise eat the drag.
		     It names the process being debugged, because there is one of these windows per process
		     and the taskbar is where somebody picks between them. -->
		<Grid x:Name="TitleBarArea" Grid.Row="0" Height="40" Padding="14,0" ColumnDefinitions="Auto,Auto,*">
			<Image x:Name="TitleMark" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" />
			<TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
				Text="RoseMCP Inspector" Style="{StaticResource CaptionTextBlockStyle}" />
		</Grid>

		<Border x:Name="Header" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="14,0,14,10">
			<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
				<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<TextBlock x:Name="SessionName" Text="No session" TextTrimming="CharacterEllipsis"
						Style="{StaticResource SubtitleTextBlockStyle}" />
					<Border x:Name="StatePill" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
						<TextBlock x:Name="StateText" Style="{StaticResource CaptionTextBlockStyle}" />
					</Border>
					<Border x:Name="ExecutionPill" Style="{StaticResource AccentPillStyle}" VerticalAlignment="Center"
						Visibility="Collapsed">
						<TextBlock x:Name="ExecutionText" Style="{StaticResource CaptionTextBlockStyle}" />
					</Border>
				</StackPanel>

				<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False"
						Foreground="{ThemeResource RoseAccentBrush}" />
					<Button x:Name="OpenLogButton" Style="{StaticResource ChipButtonStyle}" Click="OnOpenHostLog"
						Content="Host log" IsEnabled="False"
						ToolTipService.ToolTip="Open the folder holding this session's host log" />
					<Button x:Name="DetachButton" Style="{StaticResource ChipButtonStyle}" Click="OnDetach"
						Content="Detach" IsEnabled="False"
						ToolTipService.ToolTip="End the session. The target keeps running." />

					<!-- A flyout rather than a toggle in the header, because what is in it is not about
					     this session: it is a preference every RoseMCP host on the machine reads. -->
					<Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}"
						ToolTipService.ToolTip="Settings">
						<Button.Content>
							<FontIcon Glyph="&#xE713;" FontSize="13" />
						</Button.Content>
						<Button.Flyout>
							<MenuFlyout Opening="OnSettingsOpening">
								<ToggleMenuFlyoutItem x:Name="ShowOnAttach"
									Text="Show inspector when the debugger attaches"
									Click="OnToggleShowInspectorOnAttach" />
								<MenuFlyoutSeparator />
								<MenuFlyoutItem x:Name="OpenSettingsFile" Text="Open the settings file"
									Click="OnOpenSettingsFile" />
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</StackPanel>

				<TextBlock x:Name="FactsText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

				<TextBlock x:Name="XamlFactText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0" TextWrapping="Wrap"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
			</Grid>
		</Border>

		<InfoBar x:Name="Notice" Grid.Row="2" Margin="14,0,14,10" IsOpen="False" IsClosable="True" />

		<SelectorBar x:Name="Tabs" Grid.Row="3" Margin="14,0,14,8" SelectionChanged="OnTabChosen">
			<SelectorBarItem x:Name="EventsTab" Text="Events" IsSelected="True" />
			<SelectorBarItem x:Name="BreakpointsTab" Text="Breakpoints" />
			<SelectorBarItem x:Name="StackTab" Text="Stack" />
		</SelectorBar>

		<!-- Panes are toggled by visibility rather than navigated to. A Frame recreates a page on
		     every visit, which would lose the event tail, any open expander, and the scroll
		     position: all of which are the reader's place in what they were doing. -->
		<Grid Grid.Row="4" Margin="14,0,14,0">
			<panes:EventsPane x:Name="Events" />
			<panes:BreakpointsPane x:Name="Breakpoints" Visibility="Collapsed" />
			<panes:StackPane x:Name="Stack" Visibility="Collapsed" />

			<!-- Shown instead of the panes when there is no session to show them for. -->
			<StackPanel x:Name="EmptyState" Spacing="10" MaxWidth="520" VerticalAlignment="Center"
				HorizontalAlignment="Center" Visibility="Collapsed">
				<TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
					Style="{StaticResource SubtitleTextBlockStyle}" />
				<TextBlock x:Name="EmptyDetail" TextWrapping="Wrap" TextAlignment="Center"
					Style="{StaticResource BodyTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
