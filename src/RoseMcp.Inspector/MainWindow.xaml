<Window
	x:Class="RoseMcp.Inspector.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:panes="using:RoseMcp.Inspector.Panes"
	xmlns:ui="using:RoseMcp.Ui.Core"
	Title="RoseMCP Inspector">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid RowDefinitions="Auto,*">

		<!-- Title bar. Draggable region only; every control in it would otherwise eat the drag. -->
		<Grid x:Name="TitleBarArea" Grid.Row="0" Height="40" Padding="14,0" ColumnDefinitions="Auto,Auto,*">
			<Image x:Name="TitleMark" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center" />
			<TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="RoseMCP Inspector"
				Style="{StaticResource CaptionTextBlockStyle}" />
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="240,*">

			<!-- The session list. Narrow and fixed, because it is a chooser rather than the subject. -->
			<Grid Grid.Column="0" Padding="12,0,6,12" RowDefinitions="Auto,*">
				<TextBlock Grid.Row="0" Margin="4,0,0,8" Text="Debug sessions"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

				<ListView x:Name="SessionList" Grid.Row="1" SelectionMode="Single"
					SelectionChanged="OnSessionChosen"
					HorizontalContentAlignment="Stretch"
					ScrollViewer.HorizontalScrollMode="Disabled">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="ui:SessionRow">
							<!-- One line each, wrapped and bounded. Side by side they overflow a column this
							     narrow, and a horizontal StackPanel cannot trim: the second label is simply
							     cut off mid-word with nothing to say it was. -->
							<StackPanel Spacing="2" Padding="0,6">
								<TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" MaxLines="2"
									TextTrimming="CharacterEllipsis"
									Style="{StaticResource BodyStrongTextBlockStyle}" />
								<TextBlock Text="{x:Bind StateLabel, Mode=OneWay}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								<TextBlock Text="{x:Bind ExecutionLabel, Mode=OneWay}"
									Visibility="{x:Bind IsStopped, Mode=OneWay}"
									TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
									Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource RoseAccentBrush}" />
							</StackPanel>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Grid>

			<!-- The session being inspected. -->
			<Grid Grid.Column="1" Padding="6,0,14,14" RowDefinitions="Auto,Auto,Auto,*">

				<Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
					<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
						<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
							<TextBlock x:Name="SessionName" Text="No session" TextTrimming="CharacterEllipsis"
								Style="{StaticResource SubtitleTextBlockStyle}" />
							<Border x:Name="StatePill" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
								<TextBlock x:Name="StateText" Style="{StaticResource CaptionTextBlockStyle}" />
							</Border>
							<Border x:Name="ExecutionPill" Style="{StaticResource AccentPillStyle}" VerticalAlignment="Center"
								Visibility="Collapsed">
								<TextBlock x:Name="ExecutionText" Style="{StaticResource CaptionTextBlockStyle}" />
							</Border>
						</StackPanel>

						<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False"
								Foreground="{ThemeResource RoseAccentBrush}" />
							<Button x:Name="OpenLogButton" Style="{StaticResource ChipButtonStyle}" Click="OnOpenHostLog"
								Content="Host log" IsEnabled="False"
								ToolTipService.ToolTip="Open the folder holding this session's host log" />
							<Button x:Name="DetachButton" Style="{StaticResource ChipButtonStyle}" Click="OnDetach"
								Content="Detach" IsEnabled="False"
								ToolTipService.ToolTip="End the session. The target keeps running." />
						</StackPanel>

						<TextBlock x:Name="FactsText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
							Style="{StaticResource CaptionTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

						<TextBlock x:Name="XamlFactText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0" TextWrapping="Wrap"
							Style="{StaticResource CaptionTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
					</Grid>
				</Border>

				<InfoBar x:Name="Notice" Grid.Row="1" Margin="0,0,0,10" IsOpen="False" IsClosable="True" />

				<SelectorBar x:Name="Tabs" Grid.Row="2" Margin="0,0,0,8" SelectionChanged="OnTabChosen">
					<SelectorBarItem x:Name="EventsTab" Text="Events" IsSelected="True" />
					<SelectorBarItem x:Name="BreakpointsTab" Text="Breakpoints" />
				</SelectorBar>

				<!-- Panes are toggled by visibility rather than navigated to. A Frame recreates a page
				     on every visit, which would lose the event tail, any open expander, and the scroll
				     position: all of which are the reader's place in what they were doing. -->
				<Grid Grid.Row="3">
					<panes:EventsPane x:Name="Events" />
					<panes:BreakpointsPane x:Name="Breakpoints" Visibility="Collapsed" />

					<!-- Shown instead of the panes when there is no session to show them for. -->
					<StackPanel x:Name="EmptyState" Spacing="10" MaxWidth="460" VerticalAlignment="Center"
						HorizontalAlignment="Center" Visibility="Collapsed">
						<TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center"
							Style="{StaticResource SubtitleTextBlockStyle}" />
						<TextBlock x:Name="EmptyDetail" TextWrapping="Wrap" TextAlignment="Center"
							Style="{StaticResource BodyTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</Window>
