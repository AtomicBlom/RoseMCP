<UserControl
	x:Class="RoseMcp.Inspector.Panes.ThreadsPane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:inspector="using:RoseMcp.Ui.Core.Inspector">

	<Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

		<Grid Grid.Row="0" ColumnSpacing="10" ColumnDefinitions="Auto,*">
			<TextBlock Grid.Column="0" x:Name="ThreadsCaption" VerticalAlignment="Center"
				Style="{StaticResource BodyStrongTextBlockStyle}" />

			<TextBlock Grid.Column="1" x:Name="HoldText" VerticalAlignment="Center"
				HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
				Style="{StaticResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		</Grid>

		<!-- Threads are only answerable while the runtime is synchronized, so a running target gets
		     the host's own sentence about why rather than an empty list. -->
		<InfoBar x:Name="DetailBar" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Informational" />

		<ListView Grid.Row="2" x:Name="ThreadRows" SelectionMode="None"
			ScrollViewer.HorizontalScrollBarVisibility="Disabled">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="inspector:ThreadRow">
					<Grid ColumnSpacing="10" ColumnDefinitions="Auto,*" Padding="0,4">
						<TextBlock Grid.Column="0" Text="{x:Bind IdLabel}" VerticalAlignment="Top"
							MinWidth="52" TextAlignment="Right"
							Style="{StaticResource MonoTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

						<StackPanel Grid.Column="1" Spacing="1">
							<!-- The pill goes inside the text column rather than beside it. A ListView
							     gives each row a Grid of its own, so a column only one row fills is a
							     column every other row shifts left past, and the list reads ragged. -->
							<Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
								<TextBlock Grid.Column="0" Text="{x:Bind TopFrame}" TextTrimming="CharacterEllipsis" />
								<Border Grid.Column="1" Style="{StaticResource AccentPillStyle}"
									VerticalAlignment="Center" Visibility="{x:Bind IsStopped}">
									<TextBlock Text="stopped here" Style="{StaticResource CaptionTextBlockStyle}" />
								</Border>
							</Grid>

							<TextBlock Text="{x:Bind State}" Visibility="{x:Bind HasState}"
								Style="{StaticResource CaptionTextBlockStyle}"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
						</StackPanel>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</UserControl>
