<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only by nature: it loads the target's mscordbi and uses the UWP shell COM interfaces,
         so it targets net10.0-windows (which satisfies the platform-compatibility analyzer without any
         extra runtime dependency, since it uses neither WinForms nor WPF). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Publishable per-RID: the broker launches the host in the *target's* architecture, because
         ICorDebug offers no cross-architecture path. All three, because all three are reachable:
         win-x86 is the default platform of the modern UWP project template and runs under WOW64 on
         x64 and under emulation on ARM64, and win-x64 is what a classic UWP app runs as on an ARM64
         machine. Which of them a given install actually needs is decided by what its machine can
         execute, in deploy.ps1. -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- ClrDebug's LibraryImport-generated marshalling needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup Label="ICorDebug">
    <PackageReference Include="ClrDebug" />
    <!-- One per architecture an install ships a host for; only the one matching this host's RID
         copies its dbgshim.dll, and the host is published per RID. Without the x86 one the x86
         host launches, reports its architecture, and then faults on the first attach with no
         dbgshim.dll beside it (a host that ships everywhere and cannot debug anything). -->
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.win-arm64" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.win-x64" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.win-x86" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoseMcp.Contracts\RoseMcp.Contracts.csproj" />
    <ProjectReference Include="..\RoseMcp.Logging\RoseMcp.Logging.csproj" />
    <ProjectReference Include="..\RoseMcp.XamlDiff\RoseMcp.XamlDiff.csproj" />
  </ItemGroup>

</Project>
