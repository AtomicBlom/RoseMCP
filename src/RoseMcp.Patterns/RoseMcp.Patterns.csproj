<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The matcher is meant to run inside an analyzer as well as the worker, so it is held to the
         rules an analyzer is: no file system, no Workspaces, nothing a compiler host would refuse.
         RS1041 wants such an assembly on netstandard2.0 so that Visual Studio's .NET Framework host
         can load it; the only host that loads this one is RoseMcp.Worker, on net10.0 and the same
         Roslyn, so that portability is out of reach rather than merely unneeded. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.CodeAnalysis.CSharp and nothing from Workspaces: a Solution, the formatter and the
         simplifier are the worker's to supply, which is what keeps this loadable where a
         Compilation is the only thing there is. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
