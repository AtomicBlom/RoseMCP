<Application
	x:Class="RoseMcp.Tray.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
			</ResourceDictionary.MergedDictionaries>

			<!-- The rose. One accent, taken from the icon, kept for the things that are RoseMCP's
			     own: the mark, a healthy workspace's stem, a running operation's bar. Buttons and
			     text keep the system's colours, so the window sits in Windows rather than on it.
			     Each theme carries whole brushes rather than sharing colours, because a brush built
			     outside a theme dictionary does not follow a theme change. -->
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="RoseAccentBrush" Color="#C2185B" />
					<SolidColorBrush x:Key="RoseAccentSoftBrush" Color="#4DC2185B" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<!-- Lifted two steps: the icon's raspberry reads as brown on a dark ground. -->
					<SolidColorBrush x:Key="RoseAccentBrush" Color="#F27CA5" />
					<SolidColorBrush x:Key="RoseAccentSoftBrush" Color="#59F27CA5" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="HighContrast">
					<!-- No rose here. High contrast means the user's colours, and only theirs. -->
					<SolidColorBrush x:Key="RoseAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
					<SolidColorBrush x:Key="RoseAccentSoftBrush" Color="{ThemeResource SystemColorHighlightColor}" />
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>

			<!-- Endpoints, commands and durations: things that are read as characters, not words. -->
			<FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

			<Style x:Key="MonoTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
				<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
				<Setter Property="FontSize" Value="13" />
			</Style>

			<Style x:Key="MonoCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
				<Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
			</Style>

			<!-- A workspace. The system's card brushes, so it steps up from the Mica behind it by
			     exactly as much as every other Windows card does. -->
			<Style x:Key="CardStyle" TargetType="Border">
				<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="8" />
			</Style>

			<!-- The state pill beside a workspace's name. -->
			<Style x:Key="PillStyle" TargetType="Border">
				<Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="11" />
				<Setter Property="Padding" Value="8,2,10,2" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>

			<!-- Flat until hovered, which the default template supplies. -->
			<Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="Padding" Value="6" />
				<Setter Property="MinWidth" Value="32" />
				<Setter Property="MinHeight" Value="32" />
			</Style>

			<!-- Something copyable: the endpoint, the registration command. -->
			<Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
				<Setter Property="CornerRadius" Value="14" />
				<Setter Property="Padding" Value="12,4" />
				<Setter Property="MinHeight" Value="28" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
