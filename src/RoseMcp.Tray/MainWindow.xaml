<Window
	x:Class="RoseMcp.Tray.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:RoseMcp.Tray"
	xmlns:ui="using:RoseMcp.Ui.Core"
	xmlns:tb="using:H.NotifyIcon"
	Title="RoseMCP">

	<!-- Mica: the window takes its tone from the desktop behind it and the theme in force, so it
	     sits in Windows rather than on it. Where Mica is unavailable this is simply ignored. -->
	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid RowDefinitions="Auto,Auto,Auto,*">

		<Grid.Resources>
			<!-- An activity reads the same whether a workspace or a debug session is doing it, so the two
			     card templates share these rather than each carrying a copy. Hoisted here when the second
			     kind of card arrived: two copies of a template is two places for a change to land. -->
			<DataTemplate x:Key="RunningActivityTemplate" x:DataType="ui:ActivityRow">
				<Grid Margin="0,0,0,8" ColumnSpacing="12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
					<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8"
						ToolTipService.ToolTip="{x:Bind Operation}">
						<TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
						<TextBlock Text="{x:Bind Target}" Visibility="{x:Bind HasTarget}" TextTrimming="CharacterEllipsis"
							Style="{StaticResource BodyTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
					<TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Elapsed, Mode=OneWay}" VerticalAlignment="Center"
						Style="{StaticResource MonoCaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					<ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,4"
						Foreground="{ThemeResource RoseAccentBrush}"
						Value="{x:Bind Percent, Mode=OneWay}"
						IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" />
					<TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind Status, Mode=OneWay}" TextTrimming="CharacterEllipsis"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</Grid>
			</DataTemplate>
			<DataTemplate x:Key="RecentActivityTemplate" x:DataType="ui:ActivityRow">
				<Grid Padding="0,5" ColumnSpacing="10" ColumnDefinitions="Auto,*,Auto">
					<Grid Grid.Column="0" Width="14" Margin="0,3,0,0" VerticalAlignment="Top">
						<FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind Succeeded, Mode=OneWay}" />
						<FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind Failed, Mode=OneWay}" />
						<FontIcon Glyph="&#xE738;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind Cancelled, Mode=OneWay}" />
					</Grid>
					<StackPanel Grid.Column="1" Spacing="2" ToolTipService.ToolTip="{x:Bind Operation}">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}" />
							<TextBlock Text="{x:Bind Target}" Visibility="{x:Bind HasTarget}" TextTrimming="CharacterEllipsis"
								Style="{StaticResource CaptionTextBlockStyle}"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
						</StackPanel>
						<TextBlock Text="{x:Bind Error, Mode=OneWay}" Visibility="{x:Bind HasError, Mode=OneWay}" TextWrapping="Wrap"
							Style="{StaticResource CaptionTextBlockStyle}"
							Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
					</StackPanel>
					<TextBlock Grid.Column="2" Text="{x:Bind Elapsed, Mode=OneWay}"
						Style="{StaticResource MonoCaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</Grid>
			</DataTemplate>
		</Grid.Resources>

		<!-- The icon is applied in code from the shared assets: the tray needs a 32px frame
		     and the window an HICON, and neither is expressible here. -->
		<tb:TaskbarIcon
			x:Name="Tray"
			ToolTipText="RoseMCP"
			NoLeftClickDelay="True"
			LeftClickCommand="{x:Bind ShowCommand}">
			<tb:TaskbarIcon.ContextFlyout>
				<MenuFlyout Opening="OnMenuOpening">
					<MenuFlyoutItem Text="Show workspaces" Click="OnShow" />
					<MenuFlyoutSeparator />
					<ToggleMenuFlyoutItem x:Name="TrayStartWithWindows" Text="Start with Windows" Click="OnToggleStartWithWindows" />
					<MenuFlyoutItem x:Name="TrayOpenInspector" Text="Open inspector" Click="OnOpenInspector" />
					<MenuFlyoutItem Text="Copy inspector command" Click="OnCopyInspectorCommand" />
					<MenuFlyoutItem Text="Open log folder" Click="OnOpenLogs" />
					<MenuFlyoutItem Text="Close all workspaces" Click="OnCloseAll" />
					<MenuFlyoutSeparator />
					<MenuFlyoutItem Text="Exit" Click="OnExit" />
				</MenuFlyout>
			</tb:TaskbarIcon.ContextFlyout>
		</tb:TaskbarIcon>

		<!-- Title bar. All of it is drag region, so it holds nothing clickable; the system draws
		     the caption buttons over its right-hand end. -->
		<Grid x:Name="TitleBarArea" Grid.Row="0" Height="44" Padding="16,0,0,0" ColumnSpacing="10"
			ColumnDefinitions="Auto,Auto,*">
			<Image x:Name="TitleMark" Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" />
			<TextBlock Grid.Column="1" Text="RoseMCP" VerticalAlignment="Center"
				Style="{StaticResource CaptionTextBlockStyle}" />
		</Grid>

		<!-- Header: the state of the world in a line, and the one thing a client needs to reach it. -->
		<Grid Grid.Row="1" Padding="24,6,24,18" ColumnSpacing="16" ColumnDefinitions="*,Auto">
			<StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
				<TextBlock x:Name="Headline" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
				<TextBlock x:Name="Subtitle" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
				<Button Style="{StaticResource ChipButtonStyle}" Click="OnCopyEndpoint"
					ToolTipService.ToolTip="Copy the endpoint">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource RoseAccentBrush}" />
						<TextBlock x:Name="EndpointText" Style="{StaticResource MonoTextBlockStyle}" VerticalAlignment="Center" />
						<FontIcon x:Name="EndpointCopyGlyph" Glyph="&#xE8C8;" FontSize="12"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
				</Button>
				<Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="More">
					<FontIcon Glyph="&#xE712;" FontSize="16" />
					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnMenuOpening">
							<ToggleMenuFlyoutItem x:Name="WindowStartWithWindows" Text="Start with Windows"
								Click="OnToggleStartWithWindows">
								<ToggleMenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE7E8;" />
								</ToggleMenuFlyoutItem.Icon>
							</ToggleMenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem x:Name="WindowOpenInspector" Text="Open inspector" Click="OnOpenInspector">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE7B3;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem Text="Copy inspector command" Click="OnCopyInspectorCommand">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE8C8;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Text="Open log folder" Click="OnOpenLogs">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE8B7;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem Text="Close all workspaces" Click="OnCloseAll">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE711;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Text="Exit" Click="OnExit" />
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>

		<!-- Anything the window has to say for itself: a contained crash, an inspector that is not
		     installed. Closable, because none of it needs acting on twice. -->
		<InfoBar x:Name="Notice" Grid.Row="2" Margin="24,0,24,12" Severity="Informational" IsClosable="True" />

		<!-- Workspaces, then debug sessions. Both in one scroller because they are one machine's
		     state and a reader scrolling should not find a second scrollbar halfway down. -->
		<!-- The inset is the scroller's padding rather than a margin inside it, so the scrollbar sits
		     outside the inset rather than over the cards. -->
		<ScrollViewer x:Name="WorkspaceScroller" Grid.Row="3" Padding="24,0,24,24"
			VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="12">

				<ItemsRepeater x:Name="Workspaces">
					<ItemsRepeater.Layout>
						<StackLayout Spacing="12" />
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate x:DataType="local:WorkspaceRow">
							<Border Style="{StaticResource CardStyle}">
								<Grid ColumnDefinitions="Auto,*">

									<!-- The stem: rose while all is well, the colour of the trouble otherwise. -->
									<Grid Grid.Column="0" Width="4" Margin="0,16">
										<Border CornerRadius="2" Background="{ThemeResource RoseAccentSoftBrush}" Visibility="{x:Bind IsLoading, Mode=OneWay}" />
										<Border CornerRadius="2" Background="{ThemeResource RoseAccentBrush}" Visibility="{x:Bind IsHealthy, Mode=OneWay}" />
										<Border CornerRadius="2" Background="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsCaution, Mode=OneWay}" />
										<Border CornerRadius="2" Background="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind IsCritical, Mode=OneWay}" />
										<Border CornerRadius="2" Background="{ThemeResource ControlStrongFillColorDisabledBrush}" Visibility="{x:Bind IsNeutral, Mode=OneWay}" />
									</Grid>

									<StackPanel Grid.Column="1" Padding="16,14,14,14">

										<!-- Name and state on the left; cost and controls on the right. -->
										<Grid ColumnSpacing="12" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
											<TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" FontSize="16" FontWeight="SemiBold"
												VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
											<Border Grid.Column="1" Style="{StaticResource PillStyle}">
												<StackPanel Orientation="Horizontal" Spacing="6">
													<Grid Width="12" Height="12" VerticalAlignment="Center">
														<ProgressRing Width="12" Height="12" MinWidth="12" MinHeight="12"
															Foreground="{ThemeResource RoseAccentBrush}"
															IsActive="{x:Bind IsLoading, Mode=OneWay}"
															Visibility="{x:Bind IsLoading, Mode=OneWay}" />
														<Ellipse Width="8" Height="8" Fill="{ThemeResource RoseAccentBrush}" Visibility="{x:Bind IsHealthy, Mode=OneWay}" />
														<Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsCaution, Mode=OneWay}" />
														<Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind IsCritical, Mode=OneWay}" />
														<Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind IsNeutral, Mode=OneWay}" />
													</Grid>
													<TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" VerticalAlignment="Center"
														Style="{StaticResource CaptionTextBlockStyle}" />
												</StackPanel>
											</Border>
											<StackPanel Grid.Column="3" VerticalAlignment="Center">
												<TextBlock Text="{x:Bind Memory, Mode=OneWay}" HorizontalAlignment="Right"
													Style="{StaticResource BodyStrongTextBlockStyle}" />
												<TextBlock Text="{x:Bind MemoryDetail, Mode=OneWay}" HorizontalAlignment="Right"
													Visibility="{x:Bind HasMemoryDetail, Mode=OneWay}"
													Style="{StaticResource CaptionTextBlockStyle}"
													Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
											</StackPanel>
											<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
												<Button Style="{StaticResource IconButtonStyle}" Click="OnOpenFolder" Tag="{x:Bind SolutionPath}"
													ToolTipService.ToolTip="Show the solution in Explorer">
													<FontIcon Glyph="&#xE8B7;" FontSize="16" />
												</Button>
												<Button Style="{StaticResource IconButtonStyle}" Click="OnReload" Tag="{x:Bind SolutionPath}"
													ToolTipService.ToolTip="Reload: restart the worker and load the solution again. The only way to pick up a rebuilt analyzer or source generator.">
													<FontIcon Glyph="&#xE72C;" FontSize="16" />
												</Button>
												<Button Style="{StaticResource IconButtonStyle}" Click="OnClose" Tag="{x:Bind SolutionPath}"
													ToolTipService.ToolTip="Close: stop the worker and free its memory. The next call loads the solution again.">
													<FontIcon Glyph="&#xE711;" FontSize="16" />
												</Button>
											</StackPanel>
										</Grid>

										<!-- Where it is, and the facts about the process behind it. -->
										<TextBlock Margin="0,8,0,0" Text="{x:Bind SolutionPath}" ToolTipService.ToolTip="{x:Bind SolutionPath}"
											TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
											Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
										<TextBlock Margin="0,2,0,0" Text="{x:Bind Facts, Mode=OneWay}" TextTrimming="CharacterEllipsis"
											Style="{StaticResource CaptionTextBlockStyle}"
											Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

										<!-- Anything that makes the answers untrustworthy, with the fix. -->
										<InfoBar Margin="0,12,0,0" IsClosable="False"
											IsOpen="{x:Bind HasHealth, Mode=OneWay}" Visibility="{x:Bind HasHealth, Mode=OneWay}"
											Severity="{x:Bind HealthSeverity, Mode=OneWay}"
											Title="{x:Bind HealthTitle, Mode=OneWay}" Message="{x:Bind HealthMessage, Mode=OneWay}" />
										<InfoBar Margin="0,12,0,0" IsClosable="False" Severity="Informational"
											IsOpen="{x:Bind HasNotice, Mode=OneWay}" Visibility="{x:Bind HasNotice, Mode=OneWay}"
											Message="{x:Bind NoticeMessage, Mode=OneWay}" />

										<!-- What this worker is doing right now: one block per call, with the worker's
										     own last word on it underneath. -->
										<ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind Running}"
											Visibility="{x:Bind HasRunning, Mode=OneWay}"
											ItemTemplate="{StaticResource RunningActivityTemplate}" />

										<!-- Collapsed by default: history answers "what did that agent just do to my
										     solution", which is a question asked after the fact. -->
										<!-- Pulled 16px left: the header's own padding is a StaticResource baked into
										     WinUI's template, so the only way to line its text up with the facts above
										     is to move the whole control and push the content back. -->
										<Expander Margin="-16,8,0,0" Padding="16,4,0,0" MinHeight="32" Visibility="{x:Bind HasRecent, Mode=OneWay}"
											HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
											<Expander.Resources>
												<!-- Flattened: inside a card, the Expander's own fill and border are a box
												     in a box. Merged into the element's own resources because these keys are
												     only honoured from there; the same overrides at App level are found
												     after WinUI's, not before. -->
												<ResourceDictionary Source="ms-appx:///RoseMcp.Ui/Themes/FlatExpander.xaml" />
											</Expander.Resources>
											<Expander.Header>
												<TextBlock Text="{x:Bind RecentHeader, Mode=OneWay}"
													Style="{StaticResource CaptionTextBlockStyle}"
													Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
											</Expander.Header>
											<ItemsControl ItemsSource="{x:Bind Recent}"
												ItemTemplate="{StaticResource RecentActivityTemplate}" />
										</Expander>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>

				<!-- Debug sessions. A caption rather than a second header, because these are the same
				     machine's state and the section only exists when there is something in it. -->
				<TextBlock x:Name="SessionsCaption" Margin="0,12,0,0" Text="Debug sessions"
					Style="{StaticResource BodyStrongTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

				<ItemsRepeater x:Name="Sessions">
					<ItemsRepeater.Layout>
						<StackLayout Spacing="12" />
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate x:DataType="ui:SessionRow">
							<Border Style="{StaticResource CardStyle}">
								<Grid ColumnDefinitions="Auto,*">

									<Grid Grid.Column="0" Width="4" Margin="0,16">
										<Border CornerRadius="2" Background="{ThemeResource RoseAccentSoftBrush}" Visibility="{x:Bind IsStarting, Mode=OneWay}" />
										<Border CornerRadius="2" Background="{ThemeResource RoseAccentBrush}" Visibility="{x:Bind IsHealthy, Mode=OneWay}" />
										<Border CornerRadius="2" Background="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsCaution, Mode=OneWay}" />
										<Border CornerRadius="2" Background="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind IsCritical, Mode=OneWay}" />
										<Border CornerRadius="2" Background="{ThemeResource ControlStrongFillColorDisabledBrush}" Visibility="{x:Bind IsNeutral, Mode=OneWay}" />
									</Grid>

									<StackPanel Grid.Column="1" Padding="16,14,14,14">

										<!-- The name takes the star column and trims, and everything else is Auto. The
										     other way round, a name sized to its content, makes a long target
										     description push the buttons past the edge of the card, and because the card
										     then measures wider than the viewport every wrapping line below it wraps
										     outside the window too. -->
										<Grid ColumnSpacing="12" ColumnDefinitions="*,Auto,Auto">
											<TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" FontSize="16" FontWeight="SemiBold"
												VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
												ToolTipService.ToolTip="{x:Bind DisplayName}" />
											<Border Grid.Column="1" Style="{StaticResource PillStyle}">
												<StackPanel Orientation="Horizontal" Spacing="6">
													<Grid Width="12" Height="12" VerticalAlignment="Center">
														<ProgressRing Width="12" Height="12" MinWidth="12" MinHeight="12"
															Foreground="{ThemeResource RoseAccentBrush}"
															IsActive="{x:Bind IsStarting, Mode=OneWay}"
															Visibility="{x:Bind IsStarting, Mode=OneWay}" />
														<Ellipse Width="8" Height="8" Fill="{ThemeResource RoseAccentBrush}" Visibility="{x:Bind IsHealthy, Mode=OneWay}" />
														<Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsCaution, Mode=OneWay}" />
														<Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind IsCritical, Mode=OneWay}" />
														<Ellipse Width="8" Height="8" Fill="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind IsNeutral, Mode=OneWay}" />
													</Grid>
													<TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" VerticalAlignment="Center"
														Style="{StaticResource CaptionTextBlockStyle}" />
												</StackPanel>
											</Border>

											<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
												<Button Style="{StaticResource ChipButtonStyle}" Click="OnInspectSession" Tag="{x:Bind SessionId}"
													ToolTipService.ToolTip="Open the inspector on this session: its events, breakpoints, call stack and, for a XAML app, its live visual tree.">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<FontIcon Glyph="&#xE7B3;" FontSize="12" Foreground="{ThemeResource RoseAccentBrush}" />
														<TextBlock Text="Inspect" VerticalAlignment="Center"
															Style="{StaticResource CaptionTextBlockStyle}" />
													</StackPanel>
												</Button>
												<Button Style="{StaticResource IconButtonStyle}" Click="OnOpenHostLog" Tag="{x:Bind SessionId}"
													ToolTipService.ToolTip="Show this session's host log in Explorer.">
													<FontIcon Glyph="&#xE8A5;" FontSize="16" />
												</Button>
												<Button Style="{StaticResource IconButtonStyle}" Click="OnDetachSession" Tag="{x:Bind SessionId}"
													ToolTipService.ToolTip="Detach: end the session and take the debugger off the target. The app keeps running.">
													<FontIcon Glyph="&#xE711;" FontSize="16" />
												</Button>
											</StackPanel>
										</Grid>

										<TextBlock Margin="0,8,0,0" Text="{x:Bind Facts, Mode=OneWay}" TextTrimming="CharacterEllipsis"
											Style="{StaticResource CaptionTextBlockStyle}"
											Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
										<TextBlock Margin="0,2,0,0" Text="{x:Bind XamlFact, Mode=OneWay}" TextWrapping="Wrap"
											Style="{StaticResource CaptionTextBlockStyle}"
											Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

										<!-- What stopped it, in RoseMCP's own accent: a held app is this tool's doing
										     rather than the system's, and it is the state somebody has to end. On a line
										     of its own rather than a pill beside the name, because a breakpoint and a
										     thread id make a sentence rather than a label. -->
										<TextBlock Margin="0,6,0,0" Text="{x:Bind ExecutionLabel, Mode=OneWay}"
											Visibility="{x:Bind IsStopped, Mode=OneWay}" TextWrapping="Wrap"
											Style="{StaticResource CaptionTextBlockStyle}"
											Foreground="{ThemeResource RoseAccentBrush}" />

										<!-- The heartbeat, and when the target moves again. Both tick between polls,
										     because both are what a reader watches when something has gone quiet. -->
										<StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="12">
											<TextBlock Text="{x:Bind Heartbeat, Mode=OneWay}"
												Style="{StaticResource MonoCaptionTextBlockStyle}"
												Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
											<TextBlock Text="{x:Bind ResumeLabel, Mode=OneWay}"
												Visibility="{x:Bind IsStopped, Mode=OneWay}"
												Style="{StaticResource MonoCaptionTextBlockStyle}"
												Foreground="{ThemeResource RoseAccentBrush}" />
										</StackPanel>

										<InfoBar Margin="0,12,0,0" IsClosable="False" Severity="Error"
											IsOpen="{x:Bind IsFaulted, Mode=OneWay}" Visibility="{x:Bind IsFaulted, Mode=OneWay}"
											Title="This session faulted" Message="{x:Bind Detail, Mode=OneWay}" />

										<ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind Running}"
											Visibility="{x:Bind HasRunning, Mode=OneWay}"
											ItemTemplate="{StaticResource RunningActivityTemplate}" />

										<Expander Margin="-16,8,0,0" Padding="16,4,0,0" MinHeight="32" Visibility="{x:Bind HasRecent, Mode=OneWay}"
											HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
											<Expander.Resources>
												<ResourceDictionary Source="ms-appx:///RoseMcp.Ui/Themes/FlatExpander.xaml" />
											</Expander.Resources>
											<Expander.Header>
												<TextBlock Text="{x:Bind RecentHeader, Mode=OneWay}"
													Style="{StaticResource CaptionTextBlockStyle}"
													Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
											</Expander.Header>
											<ItemsControl ItemsSource="{x:Bind Recent}"
												ItemTemplate="{StaticResource RecentActivityTemplate}" />
										</Expander>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</StackPanel>
		</ScrollViewer>

		<!-- With nothing loaded and nothing being debugged, the useful thing to show is how to
		     change that. -->
		<StackPanel x:Name="EmptyState" Grid.Row="3" Margin="24,0,24,56" MaxWidth="560" Spacing="8"
			HorizontalAlignment="Center" VerticalAlignment="Center">
			<Image x:Name="EmptyMark" Width="56" Height="56" Margin="0,0,0,12" Opacity="0.9" HorizontalAlignment="Center" />
			<TextBlock MaxWidth="440" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="A solution is loaded the first time a client asks about it, and stays warm here for every session after that." />
			<TextBlock Margin="0,12,0,0" TextAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Register the endpoint with your agent:" />
			<Button Style="{StaticResource ChipButtonStyle}" Click="OnCopyRegistration" HorizontalAlignment="Center"
				ToolTipService.ToolTip="Copy">
				<Grid ColumnSpacing="10" ColumnDefinitions="*,Auto">
					<TextBlock x:Name="RegistrationText" Grid.Column="0" Style="{StaticResource MonoTextBlockStyle}"
						TextWrapping="Wrap" VerticalAlignment="Center" />
					<FontIcon x:Name="RegistrationCopyGlyph" Grid.Column="1" Glyph="&#xE8C8;" FontSize="12"
						VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</Grid>
			</Button>
		</StackPanel>
	</Grid>
</Window>
