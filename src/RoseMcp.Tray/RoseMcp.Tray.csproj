<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Overrides the repo-wide net10.0. WinUI needs a Windows target framework. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Both architectures ship. A framework-dependent publish without a RID still produces an
         apphost for the build machine, so an x64 build would drag the whole app into emulation on
         an ARM64 box, and Roslyn's design-time build is exactly the CPU-heavy part that punishes.
         RuntimeIdentifier keeps a default so a plain solution build still works. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == '' ">win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, so the tray app is xcopy-runnable with no MSIX in the way. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- XAML code generation produces warnings we do not control. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The broker is hosted in-process, so this desktop project still needs ASP.NET Core. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Remove-then-Content, because the SDK already globs these as None and including
         them twice is a duplicate-item error. -->
    <None Remove="Assets\**" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoseMcp.Broker\RoseMcp.Broker.csproj" />
  </ItemGroup>

</Project>
