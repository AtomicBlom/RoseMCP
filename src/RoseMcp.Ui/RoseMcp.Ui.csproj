<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WinUI half of the shared UI: the resource dictionaries, the window chrome, and the crash
       handler. Referenced by every RoseMCP desktop app, so they are recognisably one product rather
       than two that happen to share an icon.

       Everything testable lives next door in RoseMcp.Ui.Core, which is plain net10.0. The split is
       not tidiness: a net10.0 test project cannot reference a net10.0-windows assembly, so anything
       put here is code no unit test can reach. -->

  <PropertyGroup>
    <!-- Overrides the repo-wide net10.0, as the tray does, and for the same reason. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <!-- XAML code generation produces warnings we do not control. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- Excluded, not omitted: the WindowsAppSDK metapackage depends on it through
         Microsoft.WindowsAppSDK.ML, so it arrives whether or not it is named here. Its assets are the
         ONNX and DirectML runtimes, some 39 MB per architecture per app, and nothing in RoseMCP calls
         a machine learning API. A direct reference is what makes ExcludeAssets reach a transitive
         dependency at all. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoseMcp.Ui.Core\RoseMcp.Ui.Core.csproj" />
  </ItemGroup>

</Project>
