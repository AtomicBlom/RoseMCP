<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The one test project that takes a compile reference on RoseMcp.LiveApp, which is
         net10.0-windows. RoseMcp.IntegrationTests stays net10.0 so nothing forecloses running it
         off Windows, and the Windows-only half lives here rather than retargeting that one. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TUnit runs on Microsoft.Testing.Platform. The .NET 10 SDK dropped the VSTest bridge for
         MTP projects, so dotnet test needs this opt-in. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <!-- As a library, which is the whole point of this project existing. -->
    <ProjectReference Include="..\..\src\RoseMcp.LiveApp\RoseMcp.LiveApp.csproj" />
  </ItemGroup>

  <!-- A framework's diagnostics endpoint, compiled in as a framework compiles it, so the route a dropped-in
       tap takes can be driven end to end inside this process: the endpoint loads the test tap, and the tap
       greets the host pipe. The protocol types it uses come from RoseMcp.Contracts. The test tap is built
       first and found by path, never referenced, or the endpoint would find it already loaded. -->
  <ItemGroup>
    <Compile Include="..\..\external\RoseMcp.Tap\Endpoint\*.cs" Link="Tap\%(Filename)%(Extension)" />
    <ProjectReference Include="..\RoseMcp.TestTap\RoseMcp.TestTap.csproj" ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="TestTapPath" Value="$(MSBuildThisFileDirectory)..\RoseMcp.TestTap\bin\$(Configuration)\net10.0\RoseMcp.TestTap.dll" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
