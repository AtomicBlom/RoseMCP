<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- TUnit runs on Microsoft.Testing.Platform. The .NET 10 SDK dropped the VSTest bridge for
         MTP projects, so dotnet test needs this opt-in. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoseMcp.Broker\RoseMcp.Broker.csproj" />
    <ProjectReference Include="..\..\src\RoseMcp.Server\RoseMcp.Server.csproj" />
    <ProjectReference Include="..\..\src\RoseMcp.Worker\RoseMcp.Worker.csproj" />
    <ProjectReference Include="..\..\src\RoseMcp.XamlStubs\RoseMcp.XamlStubs.csproj" />
    <ProjectReference Include="..\..\src\RoseMcp.XamlDiff\RoseMcp.XamlDiff.csproj" />
    <!-- The UI's testable half. Deliberately not RoseMcp.Ui, which is net10.0-windows and could not
         be referenced from here at all: that split is what makes the rows and formatting testable. -->
    <ProjectReference Include="..\..\src\RoseMcp.Ui.Core\RoseMcp.Ui.Core.csproj" />
    <ProjectReference Include="..\RoseMcp.TestSupport\RoseMcp.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />

    <!-- The assertion API by its own name, aliased rather than imported, because TUnit.Core also
         reaches an Assert and an unqualified one would be ambiguous in every file. -->
    <Using Include="Xunit.Assert" Alias="Assert" />
    <!-- These used to sit in the RoseMcp.Worker.Tests namespace, nested inside RoseMcp.Worker, so
         every worker type resolved without a using. The projects are named for what they test now,
         which costs that; a global using is the same reach without 28 files of noise. -->
    <Using Include="RoseMcp.Worker" />
  </ItemGroup>

</Project>
