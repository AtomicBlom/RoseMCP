<Window
    x:Class="Rose.ProbeApp.WinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rose WinUI Probe">

    <!-- Mirrors uwp-classic/MainPage.xaml element for element, and the names are deliberately the
         same, so an assertion written against one stack can be written against the other by
         changing only the app it drives. Where the two must differ is above this line: a UWP page
         is hosted in a Frame on an ambient Window.Current, and a WinUI 3 window is an object the
         app makes and holds. Everything below is identical. -->
    <Grid x:Name="RootGrid" Background="#FF101418">
        <!-- A keyed brush, so a resource edit has a dictionary to land in. Referenced with
             ThemeResource rather than StaticResource on purpose: StaticResource resolves once when
             the tree is built, so replacing what the key means would change the dictionary and move
             nothing on screen. ThemeResource re-evaluates, which is what makes the change observable
             and therefore testable.

             Declared before the element that uses it, which is not style. XAML resolves both marker
             extensions at parse time against resources declared earlier, so a resources block placed
             after its consumer is a forward reference and the app dies on launch. -->
        <Grid.Resources>
            <SolidColorBrush x:Key="ProbeAccent" Color="#FF445566" />
        </Grid.Resources>
        <StackPanel x:Name="Panel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <Border x:Name="Pane" Background="#FF202830" Padding="24" CornerRadius="8">
                <TextBlock x:Name="Caption" Text="Rose WinUI Probe" Foreground="#FFE8EEF4" FontSize="24" />
            </Border>
            <TextBlock x:Name="Counter" Text="ticks: 0" Foreground="#FF8FA6BF" FontSize="16" HorizontalAlignment="Center" />
            <!-- The churn, and it is deliberately contained. Transient leaves the visual tree and comes
                 back on a cycle, so a test can watch a removal happen to something it has selected
                 (#51). Removing it straight out of Panel also moved everything below it, which makes
                 this app useless for judging anything positional: the pixel lens and the selection
                 outline are both things you check by looking at where they are, against a layout that
                 will not sit still.

                 A fixed-height host keeps the churn local. Transient going takes Anchor 32px up with
                 it, which is a genuine re-layout of a genuine element (so the mark following its
                 element is still exercised), and nothing outside this box moves at all.

                 (No double dashes in here. XAML runs comments through an XML parser, which rejects
                 them, and the failure arrives as a markup compiler error that does not mention
                 comments.) -->
            <Border x:Name="Churn" Height="64" Background="#FF1A2028" CornerRadius="4">
                <StackPanel x:Name="ChurnStack" Orientation="Vertical">
                    <Border x:Name="Transient" Height="32" Background="#FF303A44" Padding="8" CornerRadius="4">
                        <TextBlock x:Name="TransientCaption" Text="comes and goes" Foreground="#FF8FA6BF" FontSize="12" />
                    </Border>
                    <Border x:Name="Anchor" Height="32" Background="#FF2A3440" Padding="8" CornerRadius="4">
                        <TextBlock x:Name="AnchorCaption" Text="stays, shuffles" Foreground="#FF8FA6BF" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>
            <!-- Deliberately unnamed, under a named anchor. Every other element here has an x:Name,
                 so nothing in this app could exercise the one addressing case that matters most:
                 an element the markup never named, which is what a click lands on inside any
                 control template. Two Borders of the same type rather than one, because resolving
                 *something* is not the test. Telling Border[0] from Border[1] is. -->
            <StackPanel x:Name="Pair" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Border Background="#FF3A2A2A" Padding="6" CornerRadius="3">
                    <TextBlock Text="first" Foreground="#FF8FA6BF" FontSize="12" />
                </Border>
                <Border Background="#FF2A3A2A" Padding="6" CornerRadius="3">
                    <TextBlock Text="second" Foreground="#FF8FA6BF" FontSize="12" />
                </Border>
            </StackPanel>
            <!-- A Grid with rows, so that an attached property has somewhere to mean something. The
                 diff has always kept attached properties by their dotted name, which is a different
                 question from whether the apply side can find one, and nothing here could ask it. -->
            <Grid x:Name="Rows">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="Attached" Grid.Row="0" Text="attached" Foreground="#FF8FA6BF" FontSize="12" />
            </Grid>
            <Border x:Name="Themed" Background="{ThemeResource ProbeAccent}" Padding="4">
                <TextBlock Text="themed" Foreground="#FF8FA6BF" FontSize="12" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
