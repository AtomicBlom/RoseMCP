<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The in-solution generator case. The design-time build only puts Gen.dll on the /analyzer:
         line once Gen has actually been built, so a fresh clone yields zero generated documents
         until then. Detecting exactly this is what workspace_status is for. -->
    <ProjectReference Include="..\Gen\Gen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
